---
// IPhoneMockup.astro - Usando devices.css iPhone 14 Pro profesional
interface Props {
  imageUrl?: string;
  alt?: string;
  class?: string;
  variant?: 'device-purple' | 'device-silver' | 'device-black' | 'device-gold';
}

const {
  imageUrl,
  alt = 'Tally app screenshot',
  class: className = '',
  variant = 'device-purple',
} = Astro.props;
---

<div class:list={['device device-iphone-14-pro', variant, className]}>
  <div class="device-frame">
    {
      imageUrl ? (
        <img class="device-screen" src={imageUrl} alt={alt} loading="lazy" />
      ) : (
        <div class="device-screen">
          <slot />
        </div>
      )
    }
  </div>
  <div class="device-stripe"></div>
  <div class="device-header"></div>
  <div class="device-sensors"></div>
  <div class="device-btns"></div>
  <div class="device-power"></div>
  <div class="device-home"></div>
</div>

<style>
  /* Fix: contenido no debe sobresalir del mockup */
  :global(.device-screen) {
    overflow: hidden !important;
    border-radius: 49px !important;
    padding: 0 !important;
  }

  /* Safe area para contenido dentro del mockup */
  :global(.device-screen > *) {
    min-height: 100%;
    width: 100%;
  }

  /* Escala del mockup basada en viewport (original: 868px alto) */
  .device-iphone-14-pro {
    transform: scale(0.55); /* Mobile: ~477px alto */
    transform-origin: center center;
    /* Compensar espacio: (868 - 868*0.55)/2 = 195px vertical */
    margin: -195px auto;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .device-iphone-14-pro {
      transform: scale(0.65); /* Tablet: ~564px alto */
      margin: -152px auto;
    }
  }

  @media (min-width: 1024px) {
    .device-iphone-14-pro {
      transform: scale(0.75); /* Desktop: 651px alto */
      margin: -108px auto;
    }
  }
</style>
