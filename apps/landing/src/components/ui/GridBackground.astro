---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['bg-background absolute inset-0 -z-10 h-full w-full', className]}>
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] mask-[radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] bg-size-[24px_24px]"
  >
  </div>
</div>
