---
interface Props {
  variant?: 'default' | 'elevated';
  class?: string;
}

const { variant = 'default', class: className = '', ...rest } = Astro.props;

const baseStyles = 'rounded-xl bg-card text-card-foreground border border-border overflow-hidden';

const variants = {
  default: '',
  elevated: 'shadow-lg hover:shadow-xl transition-shadow duration-300',
};

const classes = `${baseStyles} ${variants[variant]} ${className}`;
---

<div {...rest} class={classes}>
  <slot />
</div>
