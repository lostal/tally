---
import Button from '../ui/Button.astro';
import { Bell, QrCode, Utensils } from '@lucide/astro';
---

<section
  class="from-background via-secondary/30 to-background relative flex min-h-screen items-center overflow-hidden bg-linear-to-br"
>
  <!-- Background gradient -->
  <div class="absolute inset-0 opacity-50">
    <div class="bg-primary/10 absolute top-1/4 left-1/4 h-96 w-96 rounded-full blur-3xl"></div>
    <div class="bg-secondary absolute right-1/4 bottom-1/4 h-96 w-96 rounded-full blur-3xl"></div>
  </div>

  <div class="container-landing relative z-10 py-24">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <!-- Text Content (60%) -->
      <div class="space-y-8">
        <h1
          class="font-serif text-6xl leading-tight font-bold text-balance sm:text-7xl lg:text-8xl"
        >
          Tally. <span class="text-muted-foreground">El Sistema Operativo que tus camareros amarán</span>
        </h1>

        <p class="text-muted-foreground max-w-2xl text-xl text-balance sm:text-2xl">
          TPV completo, comandas digitales, split de cuenta por QR. Todo offline-first, diseñado
          para el ritmo real de tu restaurante.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col gap-4 pt-4 sm:flex-row">
          <Button size="lg" href="https://app.paytally.app/register"> Empieza gratis </Button>
          <Button size="lg" variant="outline" href="#demo"> Ver demo → </Button>
        </div>

        <!-- Trust indicators -->
        <div class="text-muted-foreground flex items-center gap-6 pt-8 text-sm">
          <div class="flex items-center gap-2">
            <svg class="text-basil h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Sin permanencia</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="text-basil h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Prueba 30 días gratis</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="text-basil h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Verifactu Ready</span>
          </div>
        </div>
      </div>

      <!-- Visual (40%) - Tablet mockup with floating UI elements -->
      <div class="relative hidden lg:block">
        <!-- Tablet device -->
        <div class="border-primary bg-card relative rounded-2xl border-8 p-4 shadow-2xl">
          <!-- Screen content placeholder -->
          <div
            class="from-secondary to-muted relative flex aspect-4/3 items-center justify-center overflow-hidden rounded-lg bg-linear-to-br"
          >
            <!-- Grid pattern -->
            <div
              class="absolute inset-0 opacity-20"
              style="background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px); background-size: 40px 40px;"
            >
            </div>

            <!-- Floating UI elements -->
            <div class="animate-float absolute top-8 left-8">
              <Bell class="text-primary h-12 w-12" />
            </div>
            <div class="animate-float absolute right-12 bottom-12 delay-200">
              <QrCode class="text-primary h-16 w-16" />
            </div>
            <div
              class="animate-pulse-soft absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
            >
              <Utensils class="text-primary h-20 w-20 opacity-40" />
            </div>
          </div>
        </div>

        <!-- Decorative elements -->
        <div
          class="animate-pulse-soft absolute -top-8 -right-8 h-32 w-32 rounded-full bg-tomato opacity-20 blur-2xl"
        >
        </div>
        <div
          class="animate-pulse-soft absolute -bottom-8 -left-8 h-32 w-32 rounded-full bg-blueberry opacity-20 blur-2xl delay-300"
        >
        </div>
      </div>
    </div>
  </div>
</section>
