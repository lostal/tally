---
import Button from '../ui/Button.astro';
import { ArrowRight, Check } from '@lucide/astro';
---

<section class="relative flex min-h-screen items-center overflow-hidden">
  <div class="container-landing relative z-10 py-32 lg:py-24">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <!-- Text Content -->
      <div class="space-y-8">
        <h1
          class="font-serif text-6xl font-bold tracking-tight text-balance sm:text-7xl lg:text-8xl"
        >
          tally. <span class="text-muted-foreground">el sistema operativo para tu restaurante</span>
        </h1>

        <p class="text-muted-foreground max-w-xl text-xl text-balance sm:text-2xl">
          TPV offline-first, comandas digitales y pagos QR. Diseñado para la velocidad que tu equipo
          necesita.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col gap-4 sm:flex-row">
          <Button size="lg" href="https://app.paytally.app/register">
            Empieza ahora
            <ArrowRight class="ml-2 h-4 w-4" />
          </Button>
          <Button size="lg" variant="ghost" href="#demo"> Ver demo </Button>
        </div>

        <!-- Trust indicators -->
        <div class="text-muted-foreground flex flex-wrap items-center gap-6 text-sm">
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>Sin permanencia</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>30 días gratis</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>Verifactu Ready</span>
          </div>
        </div>
      </div>

      <!-- Visual - iPhone Mockup -->
      <div class="perspective-1000 relative hidden lg:block">
        <!-- iPhone Frame -->
        <div
          class="relative z-10 mx-auto h-[600px] w-[300px] rotate-x-10 -rotate-y-12 transform rounded-[2.5rem] border-14 border-gray-800 bg-gray-800 shadow-xl transition-transform duration-700 ease-out hover:rotate-0"
        >
          <div class="absolute top-[72px] -left-[17px] h-[32px] w-[3px] rounded-l-lg bg-gray-800">
          </div>
          <div class="absolute top-[124px] -left-[17px] h-[46px] w-[3px] rounded-l-lg bg-gray-800">
          </div>
          <div class="absolute top-[178px] -left-[17px] h-[46px] w-[3px] rounded-l-lg bg-gray-800">
          </div>
          <div class="absolute top-[142px] -right-[17px] h-[64px] w-[3px] rounded-r-lg bg-gray-800">
          </div>
          <div
            class="bg-background border-border/50 relative h-full w-full overflow-hidden rounded-4xl border"
          >
            <!-- Status Bar Mock -->
            <div
              class="text-foreground absolute inset-x-0 top-0 z-20 flex h-8 items-center justify-between px-6 text-[10px] font-medium"
            >
              <span>9:41</span>
              <div class="flex gap-1">
                <div class="bg-foreground h-2.5 w-4 rounded-sm"></div>
              </div>
            </div>
            <!-- Dynamic Island -->
            <div
              class="absolute top-2 left-1/2 z-20 h-7 w-24 -translate-x-1/2 rounded-full bg-black"
            >
            </div>

            <!-- Screen Content (Placeholder for QR Scan View) -->
            <div
              class="bg-muted/20 flex h-full w-full flex-col items-center justify-center p-6 text-center"
            >
              <div
                class="bg-primary/10 text-primary mb-4 flex h-16 w-16 items-center justify-center rounded-2xl"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-qr-code"
                  ><rect width="5" height="5" x="3" y="3" rx="1"></rect><rect
                    width="5"
                    height="5"
                    x="16"
                    y="3"
                    rx="1"></rect><rect width="5" height="5" x="3" y="16" rx="1"></rect><path
                    d="M21 16h-3a2 2 0 0 0-2 2v3"></path><path d="M21 21v.01"></path><path
                    d="M12 7v3a2 2 0 0 1-2 2H7"></path><path d="M3 12h.01"></path><path
                    d="M12 3h.01"></path><path d="M12 16v.01"></path><path d="M16 12h1"></path><path
                    d="M21 12v.01"></path><path d="M12 21v-1"></path></svg
                >
              </div>
              <p class="text-sm font-medium">Escanea para pedir</p>
              <p class="text-muted-foreground mt-2 text-xs">La vista del cliente aparecerá aquí</p>
            </div>
          </div>
        </div>

        <!-- Glow/Shadow behind -->
        <div
          class="bg-primary/20 absolute top-1/2 left-1/2 -z-10 h-[500px] w-[300px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[100px]"
        >
        </div>
      </div>
    </div>
  </div>
</section>
