---
import Button from '../ui/Button.astro';
import GridBackground from '../ui/GridBackground.astro';
import IPhoneMockup from '../ui/IPhoneMockup.astro';
import HeroAnimation from './HeroAnimation.astro';
import { ArrowRight, Check } from '@lucide/astro';
---

<section class="hero-trigger relative flex min-h-screen items-center overflow-x-hidden pt-24">
  <!-- Grid Background -->
  <GridBackground />

  <div class="container-landing relative z-10 py-16 sm:py-20">
    <div class="flex flex-col gap-8 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16">
      <!-- Text Content -->
      <div class="space-y-8" data-animate="fade-up">
        <h1
          class="font-serif text-6xl font-bold tracking-tight text-balance sm:text-7xl lg:text-8xl"
        >
          tally. <span class="text-muted-foreground">el sistema operativo para tu restaurante</span>
        </h1>

        <p class="text-muted-foreground max-w-xl text-xl text-balance sm:text-2xl">
          TPV offline-first, comandas digitales y pagos QR. Diseñado para la velocidad que tu equipo
          necesita.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col gap-4 sm:flex-row">
          <Button size="lg" href="https://app.paytally.app/register">
            Empieza ahora
            <ArrowRight class="ml-2 h-4 w-4" />
          </Button>
          <Button size="lg" variant="ghost" href="#demo"> Ver demo </Button>
        </div>

        <!-- Trust indicators -->
        <div
          class="text-muted-foreground flex flex-wrap items-center gap-6 text-sm"
          data-stagger="100"
        >
          <div class="flex items-center gap-2" data-animate="fade-up" data-stagger-item>
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>Sin permanencia</span>
          </div>
          <div class="flex items-center gap-2" data-animate="fade-up" data-stagger-item>
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>30 días gratis</span>
          </div>
          <div class="flex items-center gap-2" data-animate="fade-up" data-stagger-item>
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>Verifactu Ready</span>
          </div>
        </div>
      </div>

      <!-- iPhone Mockup - Responsive para desktop y móvil -->
      <div class="hero-mockup flex justify-center" data-animate="fade-up">
        <IPhoneMockup>
          <!-- QR Demo Content -->
          <div
            class="flex h-full w-full flex-col items-center justify-center bg-neutral-50 p-6 text-center dark:bg-neutral-900"
          >
            <div
              class="bg-brand-primary/10 text-brand-primary mb-4 flex h-16 w-16 items-center justify-center rounded-2xl"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="5" height="5" x="3" y="3" rx="1"></rect>
                <rect width="5" height="5" x="16" y="3" rx="1"></rect>
                <rect width="5" height="5" x="3" y="16" rx="1"></rect>
                <path d="M21 16h-3a2 2 0 0 0-2 2v3"></path>
                <path d="M21 21v.01"></path>
                <path d="M12 7v3a2 2 0 0 1-2 2H7"></path>
                <path d="M3 12h.01"></path>
                <path d="M12 3h.01"></path>
                <path d="M12 16v.01"></path>
                <path d="M16 12h1"></path>
                <path d="M21 12v.01"></path>
                <path d="M12 21v-1"></path>
              </svg>
            </div>
            <p class="text-sm font-medium">Escanea para pedir</p>
            <p class="mt-2 text-xs text-neutral-600 dark:text-neutral-400">
              Demo interactivo del flujo QR
            </p>
          </div>
        </IPhoneMockup>
      </div>
    </div>
  </div>
</section>

<!-- Hero Reveal Animation Script -->
<HeroAnimation />
