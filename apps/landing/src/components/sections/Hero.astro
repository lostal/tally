---
import Button from '../ui/Button.astro';
import { ArrowRight, Check } from '@lucide/astro';
---

<section class="relative flex min-h-screen items-center overflow-hidden">

  <div class="container-landing relative z-10 py-32 lg:py-24">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <!-- Text Content -->
      <div class="animate-fade-in-up space-y-8">
        <h1
          class="font-serif text-6xl font-bold tracking-tight text-balance sm:text-7xl lg:text-8xl"
        >
          tally. <span class="text-muted-foreground">el sistema operativo para tu restaurante</span>
        </h1>

        <p class="text-muted-foreground max-w-xl text-xl text-balance sm:text-2xl">
          TPV offline-first, comandas digitales y pagos QR. Diseñado para la velocidad que tu equipo
          necesita.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col gap-4 sm:flex-row">
          <Button size="lg" href="https://app.paytally.app/register">
            Empieza ahora
            <ArrowRight class="ml-2 h-4 w-4" />
          </Button>
          <Button size="lg" variant="ghost" href="#demo"> Ver demo </Button>
        </div>

        <!-- Trust indicators -->
        <div class="text-muted-foreground flex flex-wrap items-center gap-6 text-sm">
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>Sin permanencia</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>30 días gratis</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>Verifactu Ready</span>
          </div>
        </div>
      </div>

      <!-- Visual - iPhone Mockup -->
      <div class="animate-fade-in-up relative hidden delay-200 lg:block perspective-1000">
        <!-- iPhone Frame -->
        <div class="relative mx-auto border-gray-800 bg-gray-800 border-14 rounded-[2.5rem] h-[600px] w-[300px] shadow-xl transform -rotate-y-12 rotate-x-10 hover:rotate-0 transition-transform duration-700 ease-out z-10">
            <div class="h-[32px] w-[3px] bg-gray-800 absolute -left-[17px] top-[72px] rounded-l-lg"></div>
            <div class="h-[46px] w-[3px] bg-gray-800 absolute -left-[17px] top-[124px] rounded-l-lg"></div>
            <div class="h-[46px] w-[3px] bg-gray-800 absolute -left-[17px] top-[178px] rounded-l-lg"></div>
            <div class="h-[64px] w-[3px] bg-gray-800 absolute -right-[17px] top-[142px] rounded-r-lg"></div>
            <div class="rounded-4xl overflow-hidden w-full h-full bg-background relative border border-border/50">
                 <!-- Status Bar Mock -->
                 <div class="absolute top-0 inset-x-0 h-8 z-20 flex justify-between items-center px-6 text-[10px] font-medium text-foreground">
                    <span>9:41</span>
                    <div class="flex gap-1">
                        <div class="h-2.5 w-4 bg-foreground rounded-sm"></div>
                    </div>
                 </div>
                <!-- Dynamic Island -->
                <div class="absolute top-2 left-1/2 -translate-x-1/2 w-24 h-7 bg-black rounded-full z-20"></div>

                <!-- Screen Content (Placeholder for QR Scan View) -->
                <div class="w-full h-full bg-muted/20 flex flex-col items-center justify-center p-6 text-center">
                    <div class="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center text-primary mb-4">
                         <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-qr-code"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
                    </div>
                    <p class="text-sm font-medium">Escanea para pedir</p>
                     <p class="text-xs text-muted-foreground mt-2">La vista del cliente aparecerá aquí</p>
                </div>
            </div>
        </div>

        <!-- Glow/Shadow behind -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[500px] bg-primary/20 blur-[100px] -z-10 rounded-full"></div>
      </div>
    </div>
  </div>
</section>
