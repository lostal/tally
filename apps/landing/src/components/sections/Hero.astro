---
import Button from '../ui/Button.astro';
import GridBackground from '../ui/GridBackground.astro';
import { ArrowRight, Check } from '@lucide/astro';
---

<section class="relative flex min-h-screen items-center overflow-hidden">
  <GridBackground />

  <div class="container-landing relative z-10 py-32 lg:py-24">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <!-- Text Content -->
      <div class="animate-fade-in-up space-y-8">
        <h1
          class="font-serif text-6xl font-bold tracking-tight text-balance sm:text-7xl lg:text-8xl"
        >
          tally. <span class="text-muted-foreground">el sistema operativo para tu restaurante</span>
        </h1>

        <p class="text-muted-foreground max-w-xl text-xl text-balance sm:text-2xl">
          TPV offline-first, comandas digitales y pagos QR. Diseñado para la velocidad que tu equipo
          necesita.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col gap-4 sm:flex-row">
          <Button size="lg" href="https://app.paytally.app/register">
            Empieza ahora
            <ArrowRight class="ml-2 h-4 w-4" />
          </Button>
          <Button size="lg" variant="ghost" href="#demo"> Ver demo </Button>
        </div>

        <!-- Trust indicators -->
        <div class="text-muted-foreground flex flex-wrap items-center gap-6 text-sm">
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>Sin permanencia</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>30 días gratis</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 flex h-5 w-5 items-center justify-center rounded-full">
              <Check class="text-primary h-3 w-3" />
            </div>
            <span>Verifactu Ready</span>
          </div>
        </div>
      </div>

      <!-- Visual - Clean Interface Mockup -->
      <div class="animate-fade-in-up relative hidden delay-200 lg:block">
        <div class="bg-background relative rounded-xl border shadow-2xl">
          <div class="flex items-center gap-2 border-b px-4 py-3">
            <div class="bg-muted-foreground/20 h-3 w-3 rounded-full"></div>
            <div class="bg-muted-foreground/20 h-3 w-3 rounded-full"></div>
            <div class="bg-muted-foreground/20 h-3 w-3 rounded-full"></div>
          </div>
          <div class="bg-secondary/20 aspect-video overflow-hidden rounded-b-xl relative group">
             <!-- Static Image -->
            <img
              src="/placeholder-hero.png"
              alt="Dashboard de Tally"
              class="w-full h-full object-cover"
              width={1920}
              height={1080}
            />

            <!-- Gradient overlay for better text contrast if needed, or just polish -->
            <div class="absolute inset-0 bg-linear-to-t from-background/20 to-transparent pointer-events-none"></div>
          </div>
        </div>

        <!-- Subtle Glow behind -->
        <div
          class="from-primary/20 absolute -inset-4 -z-10 rounded-xl bg-linear-to-tr to-transparent opacity-50 blur-3xl"
        >
        </div>
      </div>
    </div>
  </div>
</section>
