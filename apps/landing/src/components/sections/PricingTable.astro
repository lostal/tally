---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { Check, X, ArrowRight } from '@lucide/astro';
---

<Section id="pricing">
  <div class="mx-auto mb-16 max-w-3xl text-center">
    <h2
      class="text-foreground mb-6 font-serif text-4xl font-medium tracking-tight text-balance sm:text-5xl"
    >
      Precios transparentes
    </h2>
    <p class="text-muted-foreground text-xl text-balance">
      Escale con su negocio. Sin costes ocultos.
    </p>
  </div>

  <!-- Toggle Annual/Monthly -->
  <div class="mb-20 flex items-center justify-center gap-4">
    <span class="text-muted-foreground text-sm font-medium">Mensual</span>
    <button
      id="pricing-toggle"
      class="bg-input hover:bg-input/80 focus:ring-ring data-[checked=true]:bg-primary relative h-7 w-12 rounded-full transition-colors focus:ring-2 focus:ring-offset-2 focus:outline-none"
      role="switch"
      aria-checked="true"
      data-checked="true"
    >
      <span
        class="bg-background block h-5 w-5 translate-x-1 rounded-full shadow-lg transition-transform data-[checked=true]:translate-x-6"
        data-checked="true"></span>
    </button>
    <span class="text-foreground flex items-center gap-2 text-sm font-medium">
      Anual <Badge
        variant="basil"
        size="sm"
        class="rounded-full px-2 py-0.5 text-[10px] tracking-wider uppercase">-20%</Badge
      >
    </span>
  </div>

  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-3">
    <!-- Essential -->
    <div
      class="border-border/50 bg-card/30 hover:bg-card relative flex flex-col rounded-3xl border p-8 transition-all duration-300 hover:shadow-xl"
    >
      <div class="mb-8">
        <h3 class="mb-2 font-serif text-xl font-medium">Essential</h3>
        <div class="flex items-baseline gap-1">
          <span class="text-4xl font-bold tracking-tight">€0</span>
          <span class="text-muted-foreground">/mes</span>
        </div>
        <p class="text-muted-foreground mt-4 text-sm leading-relaxed">
          Perfecto para empezar. Todo lo necesario para un pequeño local o food truck.
        </p>
      </div>
      <div class="mb-8 flex-1 space-y-4">
        <div class="text-foreground/80 flex items-start gap-3 text-sm">
          <Check class="text-primary mt-0.5 h-4 w-4 shrink-0" />
          <span>1 Local</span>
        </div>
        <div class="text-foreground/80 flex items-start gap-3 text-sm">
          <Check class="text-primary mt-0.5 h-4 w-4 shrink-0" />
          <span>50 Comandas/mes</span>
        </div>
        <div class="text-foreground/80 flex items-start gap-3 text-sm">
          <Check class="text-primary mt-0.5 h-4 w-4 shrink-0" />
          <span>Split de cuenta QR</span>
        </div>
        <div class="text-muted-foreground/50 flex items-start gap-3 text-sm">
          <X class="mt-0.5 h-4 w-4 shrink-0" />
          <span>Sin Analytics</span>
        </div>
      </div>
      <Button variant="outline" href="https://app.paytally.app/register" class="w-full rounded-xl"
        >Empezar Gratis</Button
      >
    </div>

    <!-- Pro -->
    <div
      class="border-primary/20 bg-card shadow-primary/5 relative z-10 flex scale-105 flex-col rounded-3xl border p-8 shadow-2xl"
    >
      <div class="absolute -top-4 left-1/2 -translate-x-1/2">
        <div
          class="bg-tomato rounded-full px-3 py-1 text-xs font-bold tracking-wide text-white uppercase shadow-sm"
        >
          Más Popular
        </div>
      </div>
      <div class="mb-8">
        <h3 class="text-primary mb-2 font-serif text-xl font-medium">Pro</h3>
        <div class="flex items-baseline gap-1">
          <span class="text-5xl font-bold tracking-tight" id="pro-price">39</span>
          <span class="text-5xl font-bold tracking-tight">€</span>
          <span class="text-muted-foreground">/mes</span>
        </div>
        <p class="text-muted-foreground mt-4 text-sm leading-relaxed">
          Potencia total para restaurantes en crecimiento. Sin límites.
        </p>
      </div>
      <div class="mb-8 flex-1 space-y-4">
        <div class="text-foreground flex items-start gap-3 text-sm">
          <div class="bg-primary/10 flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
            <Check class="text-primary h-3 w-3" />
          </div>
          <span class="font-medium">Locales Ilimitados</span>
        </div>
        <div class="text-foreground flex items-start gap-3 text-sm">
          <div class="bg-primary/10 flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
            <Check class="text-primary h-3 w-3" />
          </div>
          <span class="font-medium">Comandas Ilimitadas</span>
        </div>
        <div class="text-foreground flex items-start gap-3 text-sm">
          <div class="bg-primary/10 flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
            <Check class="text-primary h-3 w-3" />
          </div>
          <span>Analytics Avanzados</span>
        </div>
        <div class="text-foreground flex items-start gap-3 text-sm">
          <div class="bg-primary/10 flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
            <Check class="text-primary h-3 w-3" />
          </div>
          <span>Soporte Prioritario</span>
        </div>
      </div>
      <Button
        href="https://app.paytally.app/register"
        class="shadow-primary/20 h-12 w-full rounded-xl text-base shadow-lg"
      >
        Prueba 30 días Gratis
      </Button>
    </div>

    <!-- Enterprise -->
    <div
      class="border-border/50 bg-card/30 hover:bg-card relative flex flex-col rounded-3xl border p-8 transition-all duration-300 hover:shadow-xl"
    >
      <div class="mb-8">
        <h3 class="mb-2 font-serif text-xl font-medium">Enterprise</h3>
        <div class="flex items-baseline gap-1">
          <span class="text-4xl font-bold tracking-tight">Custom</span>
        </div>
        <p class="text-muted-foreground mt-4 text-sm leading-relaxed">
          Para cadenas y franquicias con necesidades específicas de integración.
        </p>
      </div>
      <div class="mb-8 flex-1 space-y-4">
        <div class="text-foreground/80 flex items-start gap-3 text-sm">
          <div class="bg-muted flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
            <Check class="text-muted-foreground h-3 w-3" />
          </div>
          <span>Todo lo de Pro</span>
        </div>
        <div class="text-foreground/80 flex items-start gap-3 text-sm">
          <div class="bg-muted flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
            <Check class="text-muted-foreground h-3 w-3" />
          </div>
          <span>Gestión Multi-franquicia</span>
        </div>
        <div class="text-foreground/80 flex items-start gap-3 text-sm">
          <div class="bg-muted flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
            <Check class="text-muted-foreground h-3 w-3" />
          </div>
          <span>API Access</span>
        </div>
        <div class="text-foreground/80 flex items-start gap-3 text-sm">
          <div class="bg-muted flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
            <Check class="text-muted-foreground h-3 w-3" />
          </div>
          <span>SLA Garantizado</span>
        </div>
      </div>
      <Button variant="ghost" href="mailto:sales@paytally.app" class="group w-full rounded-xl">
        Contactar Ventas <ArrowRight
          class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1"
        />
      </Button>
    </div>
  </div>
</Section>

<script>
  // Simple number animation function
  function animateValue(obj: HTMLElement, start: number, end: number, duration: number) {
    let startTimestamp: number | null = null;
    const step = (timestamp: number) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);

      // Ease out quart
      const easeProgress = 1 - Math.pow(1 - progress, 4);

      obj.innerHTML = Math.floor(easeProgress * (end - start) + start).toString();

      if (progress < 1) {
        window.requestAnimationFrame(step);
      } else {
        obj.innerHTML = end.toString();
      }
    };
    window.requestAnimationFrame(step);
  }

  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('pricing-toggle');
    if (!toggleBtn) return;

    const proPrice = document.getElementById('pro-price');
    let isAnnual = true;

    toggleBtn.addEventListener('click', () => {
      isAnnual = !isAnnual;
      toggleBtn.setAttribute('aria-checked', String(isAnnual));
      toggleBtn.setAttribute('data-checked', String(isAnnual));

      const knob = toggleBtn.querySelector('span');
      knob?.setAttribute('data-checked', String(isAnnual));

      if (proPrice) {
        const start = isAnnual ? 49 : 39;
        const end = isAnnual ? 39 : 49;
        animateValue(proPrice, start, end, 300);
      }
    });
  });
</script>
