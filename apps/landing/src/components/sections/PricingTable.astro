---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { Check, X, ArrowRight } from '@lucide/astro';
---

<Section id="pricing">
  <div class="mx-auto mb-16 max-w-3xl text-center">
    <h2 class="mb-6 font-serif text-4xl font-medium tracking-tight text-foreground sm:text-5xl text-balance">
      Precios transparentes
    </h2>
    <p class="text-xl text-muted-foreground text-balance">
      Escale con su negocio. Sin costes ocultos.
    </p>
  </div>

  <!-- Toggle Annual/Monthly -->
  <div class="mb-20 flex items-center justify-center gap-4">
    <span class="text-muted-foreground text-sm font-medium">Mensual</span>
    <button
      id="pricing-toggle"
      class="relative h-7 w-12 rounded-full bg-input transition-colors hover:bg-input/80 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 data-[checked=true]:bg-primary"
      role="switch"
      aria-checked="true"
      data-checked="true"
    >
      <span
        class="block h-5 w-5 translate-x-1 rounded-full bg-background shadow-lg transition-transform data-[checked=true]:translate-x-6"
        data-checked="true"
      ></span>
    </button>
    <span class="text-foreground text-sm font-medium flex items-center gap-2">
      Anual <Badge variant="basil" size="sm" class="rounded-full px-2 py-0.5 text-[10px] uppercase tracking-wider">-20%</Badge>
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
      <!-- Essential -->
      <div class="flex flex-col p-8 rounded-3xl border border-border/50 bg-card/30 hover:bg-card hover:shadow-xl transition-all duration-300 relative">
          <div class="mb-8">
              <h3 class="text-xl font-serif font-medium mb-2">Essential</h3>
              <div class="flex items-baseline gap-1">
                  <span class="text-4xl font-bold tracking-tight">€0</span>
                  <span class="text-muted-foreground">/mes</span>
              </div>
              <p class="text-muted-foreground text-sm mt-4 leading-relaxed">
                  Perfecto para empezar. Todo lo necesario para un pequeño local o food truck.
              </p>
          </div>
          <div class="space-y-4 mb-8 flex-1">
               <div class="flex items-start gap-3 text-sm text-foreground/80">
                   <Check class="w-4 h-4 text-primary mt-0.5 shrink-0" />
                   <span>1 Local</span>
               </div>
               <div class="flex items-start gap-3 text-sm text-foreground/80">
                   <Check class="w-4 h-4 text-primary mt-0.5 shrink-0" />
                   <span>50 Comandas/mes</span>
               </div>
               <div class="flex items-start gap-3 text-sm text-foreground/80">
                   <Check class="w-4 h-4 text-primary mt-0.5 shrink-0" />
                   <span>Split de cuenta QR</span>
               </div>
               <div class="flex items-start gap-3 text-sm text-muted-foreground/50">
                   <X class="w-4 h-4 mt-0.5 shrink-0" />
                   <span>Sin Analytics</span>
               </div>
          </div>
          <Button variant="outline" href="https://app.paytally.app/register" class="w-full rounded-xl">Empezar Gratis</Button>
      </div>

      <!-- Pro -->
      <div class="flex flex-col p-8 rounded-3xl border border-primary/20 bg-card shadow-2xl shadow-primary/5 relative scale-105 z-10">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <div class="bg-tomato text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide shadow-sm">
                  Más Popular
              </div>
          </div>
          <div class="mb-8">
              <h3 class="text-xl font-serif font-medium text-primary mb-2">Pro</h3>
              <div class="flex items-baseline gap-1">
                  <span class="text-5xl font-bold tracking-tight" id="pro-price">€39</span>
                  <span class="text-muted-foreground">/mes</span>
              </div>
              <p class="text-muted-foreground text-sm mt-4 leading-relaxed">
                  Potencia total para restaurantes en crecimiento. Sin límites.
              </p>
          </div>
          <div class="space-y-4 mb-8 flex-1">
               <div class="flex items-start gap-3 text-sm text-foreground">
                   <div class="w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                       <Check class="w-3 h-3 text-primary" />
                   </div>
                   <span class="font-medium">Locales Ilimitados</span>
               </div>
               <div class="flex items-start gap-3 text-sm text-foreground">
                   <div class="w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                       <Check class="w-3 h-3 text-primary" />
                   </div>
                   <span class="font-medium">Comandas Ilimitadas</span>
               </div>
               <div class="flex items-start gap-3 text-sm text-foreground">
                   <div class="w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                       <Check class="w-3 h-3 text-primary" />
                   </div>
                   <span>Analytics Avanzados</span>
               </div>
               <div class="flex items-start gap-3 text-sm text-foreground">
                   <div class="w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                       <Check class="w-3 h-3 text-primary" />
                   </div>
                   <span>Soporte Prioritario</span>
               </div>
          </div>
          <Button href="https://app.paytally.app/register" class="w-full rounded-xl h-12 text-base shadow-lg shadow-primary/20">
              Prueba 30 días Gratis
          </Button>
      </div>

      <!-- Enterprise -->
      <div class="flex flex-col p-8 rounded-3xl border border-border/50 bg-card/30 hover:bg-card hover:shadow-xl transition-all duration-300 relative">
          <div class="mb-8">
              <h3 class="text-xl font-serif font-medium mb-2">Enterprise</h3>
              <div class="flex items-baseline gap-1">
                  <span class="text-4xl font-bold tracking-tight">Custom</span>
              </div>
              <p class="text-muted-foreground text-sm mt-4 leading-relaxed">
                  Para cadenas y franquicias con necesidades específicas de integración.
              </p>
          </div>
          <div class="space-y-4 mb-8 flex-1">
               <div class="flex items-start gap-3 text-sm text-foreground/80">
                   <div class="w-5 h-5 rounded-full bg-muted flex items-center justify-center shrink-0">
                       <Check class="w-3 h-3 text-muted-foreground" />
                   </div>
                   <span>Todo lo de Pro</span>
               </div>
               <div class="flex items-start gap-3 text-sm text-foreground/80">
                   <div class="w-5 h-5 rounded-full bg-muted flex items-center justify-center shrink-0">
                       <Check class="w-3 h-3 text-muted-foreground" />
                   </div>
                   <span>Gestión Multi-franquicia</span>
               </div>
               <div class="flex items-start gap-3 text-sm text-foreground/80">
                   <div class="w-5 h-5 rounded-full bg-muted flex items-center justify-center shrink-0">
                       <Check class="w-3 h-3 text-muted-foreground" />
                   </div>
                   <span>API Access</span>
               </div>
               <div class="flex items-start gap-3 text-sm text-foreground/80">
                   <div class="w-5 h-5 rounded-full bg-muted flex items-center justify-center shrink-0">
                       <Check class="w-3 h-3 text-muted-foreground" />
                   </div>
                   <span>SLA Garantizado</span>
               </div>
          </div>
          <Button variant="ghost" href="mailto:sales@paytally.app" class="w-full rounded-xl group">
              Contactar Ventas <ArrowRight class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </Button>
      </div>
  </div>
</Section>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('pricing-toggle');
    if(!toggleBtn) return;

    const knob = toggleBtn.querySelector('span');
    const proPrice = document.getElementById('pro-price');
    let isAnnual = true;

    toggleBtn.addEventListener('click', () => {
        isAnnual = !isAnnual;
        toggleBtn.setAttribute('aria-checked', String(isAnnual));
        toggleBtn.setAttribute('data-checked', String(isAnnual));
        knob?.setAttribute('data-checked', String(isAnnual));

        if(proPrice) {
            // Simple animation or transition could go here
            proPrice.textContent = isAnnual ? '€39' : '€49';
        }
    });
  });
</script>
