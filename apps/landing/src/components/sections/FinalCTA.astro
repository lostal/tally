---

---

<section id="final-cta" class="relative z-20 overflow-hidden pt-24 md:pt-32">
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      id="cta-container"
      class="bg-foreground text-background dark:text-foreground relative mx-auto w-full overflow-hidden rounded-[40px] px-6 py-20 text-center md:px-16 md:py-28 dark:bg-neutral-900"
      style="transform: translateZ(0); mask-image: radial-gradient(white, black);"
    >
      <!-- Background Mesh - NO BLUR for WebKit performance -->
      <div class="pointer-events-none absolute inset-0">
        <div
          class="absolute top-0 left-0 h-full w-full bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.08),transparent_70%)]"
        >
        </div>
        <div
          class="bg-tomato absolute -bottom-1/2 -left-1/2 h-full w-full opacity-10 blur-[100px] dark:opacity-5"
        >
        </div>
        <div
          class="bg-blueberry absolute -top-1/2 -right-1/2 h-full w-full opacity-10 blur-[100px] dark:opacity-5"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto max-w-4xl space-y-10">
        <h2
          class="text-background dark:text-foreground font-serif text-5xl font-bold tracking-tight text-balance sm:text-6xl md:text-7xl"
        >
          Tu restaurante, <br />
          <span
            class="from-tomato to-blueberry animate-gradient-x bg-linear-to-r via-white bg-clip-text text-transparent"
            >siguiente nivel.</span
          >
        </h2>
        <p
          class="text-background/80 dark:text-foreground/80 mx-auto max-w-2xl text-xl leading-relaxed text-balance md:text-2xl"
        >
          Sin tarjeta de crédito. Sin permanencia. <br />
          Únete a los restaurantes que ya están facturando más.
        </p>

        <div class="flex flex-col items-center justify-center gap-4 pt-4 sm:flex-row">
          <a
            href="https://app.paytally.app/register"
            class="bg-background dark:bg-foreground text-foreground dark:text-background hover:bg-background/90 inline-flex h-14 items-center justify-center rounded-full px-8 text-lg font-bold transition-colors"
          >
            Empezar gratis
          </a>
          <a
            href="mailto:hola@paytally.app"
            class="border-background dark:border-foreground text-background dark:text-foreground hover:bg-background dark:hover:bg-foreground hover:text-foreground dark:hover:text-background inline-flex h-14 items-center justify-center rounded-full border-2 bg-transparent px-8 text-lg font-semibold transition-all"
          >
            Agendar Demo
          </a>
        </div>

        <div
          class="text-background/60 dark:text-foreground/60 flex items-center justify-center gap-8 pt-8 text-sm"
        >
          <div class="flex items-center gap-2">
            <div class="bg-basil h-1.5 w-1.5 rounded-full"></div>
            30 días de prueba
          </div>
          <div class="flex items-center gap-2">
            <div class="bg-tomato h-1.5 w-1.5 rounded-full"></div>
            Setup en 5 min
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
