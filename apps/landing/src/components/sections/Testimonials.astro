---
const testimonials = [
  {
    name: 'María González',
    role: 'Dueña de La Terraza',
    image: 'https://ui-avatars.com/api/?name=Maria+Gonzalez&size=128&background=0D8ABC&color=fff',
    message:
      'Tally transformó completamente la experiencia de nuestros clientes. Ya no hay colas para pagar y el equipo trabaja mucho más eficiente.',
  },
  {
    name: 'Carlos Ruiz',
    role: 'Gerente de Grupo Sabor',
    image: 'https://ui-avatars.com/api/?name=Carlos+Ruiz&size=128&background=6366F1&color=fff',
    message:
      'Implementamos Tally en nuestros 5 restaurantes. La centralización de datos y reportes nos da un control total del negocio.',
  },
  {
    name: 'Ana Martínez',
    role: 'Chef y Propietaria',
    image: 'https://ui-avatars.com/api/?name=Ana+Martinez&size=128&background=EC4899&color=fff',
    message:
      'La mejor decisión que tomamos. Nuestros meseros aman lo fácil que es y los clientes quedan encantados con los pagos QR.',
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-12 sm:gap-16">
      <h2 class="text-foreground text-center text-3xl font-medium tracking-tight sm:text-4xl">
        Lo que dicen nuestros clientes
      </h2>
      <div class="grid gap-8 lg:grid-cols-3">
        {
          testimonials.map((testimonial) => (
            <figure class="flex flex-col items-center gap-8 rounded-3xl bg-neutral-100/50 px-6 py-10 backdrop-blur-sm dark:bg-neutral-900/50">
              <div class="flex gap-0.5">
                {Array.from({ length: 5 }).map(() => (
                  <svg
                    class="h-6 w-6 text-amber-400"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12.0006 18.26L4.94715 22.2082L6.52248 14.2799L0.587891 8.7918L8.61493 7.84006L12.0006 0.5L15.3862 7.84006L23.4132 8.7918L17.4787 14.2799L19.054 22.2082L12.0006 18.26Z" />
                  </svg>
                ))}
              </div>
              <blockquote class="text-foreground/80 text-center text-lg leading-loose italic">
                <p>"{testimonial.message}"</p>
              </blockquote>
              <figcaption class="flex flex-col items-center gap-4">
                <img
                  class="h-12 w-12 rounded-full object-cover"
                  src={testimonial.image}
                  alt={testimonial.name}
                />
                <div class="text-center">
                  <div class="text-foreground text-base font-medium">{testimonial.name}</div>
                  <div class="text-muted-foreground text-sm">{testimonial.role}</div>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
