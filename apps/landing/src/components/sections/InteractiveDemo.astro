---
import Section from '../ui/Section.astro';
import {
  MapPin,
  ClipboardList,
  ChefHat,
  QrCode,
  Users,
  CheckCircle,
  ArrowRight,
} from '@lucide/astro';
---

<Section id="demo" className="relative overflow-hidden">
  <div class="mx-auto mb-20 max-w-3xl md:text-center">
    <h2
      class="text-foreground mb-6 font-serif text-4xl font-medium tracking-tight text-balance sm:text-5xl md:text-6xl"
      data-animate="fade-up"
    >
      Experiencia fluida, <br />
      <span class="text-muted-foreground italic">mesa a mesa.</span>
    </h2>
    <p class="text-muted-foreground text-xl text-balance" data-animate="fade-up">
      Un recorrido diseñado para eliminar fricción. Desde que el cliente se sienta hasta que paga.
    </p>
  </div>

  <div class="relative mx-auto max-w-5xl">
    <!-- Central Connecting Line (Desktop) -->
    <div
      class="via-border absolute top-0 bottom-0 left-1/2 hidden w-px bg-linear-to-b from-transparent to-transparent md:block"
    >
    </div>

    <div class="relative space-y-12 md:space-y-0" data-stagger="200">
      <!-- Step 1: Left -->
      <div class="group md:flex md:items-center md:justify-between" data-animate="fade-up" data-stagger-item>
        <div class="order-1 md:w-[42%] md:text-right">
          <h3
            class="text-foreground group-hover:text-primary mb-2 font-serif text-2xl font-medium transition-colors"
          >
            1. Plano de Sala
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Visualización en tiempo real de mesas libres, ocupadas y tiempos de espera. Asigna mesas
            con un solo toque.
          </p>
        </div>
        <div class="relative order-2 my-4 flex justify-center md:my-0 md:w-[16%]">
          <div
            class="bg-card border-border group-hover:border-primary/50 z-10 flex h-12 w-12 items-center justify-center rounded-2xl border shadow-sm transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_var(--color-primary)]"
          >
            <MapPin class="text-primary h-5 w-5" />
          </div>
        </div>
        <div
          class="bg-card/50 border-border/50 group-hover:bg-card group-hover:border-primary/20 order-3 rounded-2xl border p-6 backdrop-blur-sm transition-all duration-300 md:w-[42%]"
        >
          <!-- Abstract UI Representation -->
          <div class="grid grid-cols-2 gap-3 opacity-60 transition-opacity group-hover:opacity-100">
            <div
              class="flex h-16 items-center justify-center rounded-lg border border-green-500/20 bg-green-500/10"
            >
              <span class="text-xs font-medium text-green-600">Libre</span>
            </div>
            <div
              class="flex h-16 items-center justify-center rounded-lg border border-red-500/20 bg-red-500/10"
            >
              <span class="text-xs font-medium text-red-600">Ocupada</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: Right -->
      <div class="group md:flex md:items-center md:justify-between" data-animate="fade-up" data-stagger-item>
        <div class="order-1 md:order-3 md:w-[42%]">
          <h3
            class="text-foreground group-hover:text-blueberry mb-2 font-serif text-2xl font-medium transition-colors"
          >
            2. Comanda Digital
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Toma nota en la mesa sin papeletas. Modificadores, notas de cocina y alérgenos
            sincronizados al instante.
          </p>
        </div>
        <div class="relative order-2 my-4 flex justify-center md:my-0 md:w-[16%]">
          <div
            class="bg-card border-border group-hover:border-blueberry/50 z-10 flex h-12 w-12 items-center justify-center rounded-2xl border shadow-sm transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_var(--color-blueberry)]"
          >
            <ClipboardList class="text-blueberry h-5 w-5" />
          </div>
        </div>
        <div
          class="bg-card/50 border-border/50 group-hover:bg-card group-hover:border-blueberry/20 order-3 rounded-2xl border p-6 backdrop-blur-sm transition-all duration-300 md:order-1 md:w-[42%] md:text-right"
        >
          <div class="flex flex-col gap-2 opacity-60 transition-opacity group-hover:opacity-100">
            <div class="bg-muted/50 h-8 w-3/4 self-end rounded"></div>
            <div class="bg-muted/30 h-8 w-1/2 self-end rounded"></div>
            <div class="bg-blueberry/10 h-8 w-2/3 self-end rounded"></div>
          </div>
        </div>
      </div>

      <!-- Step 3: Left -->
      <div class="group md:flex md:items-center md:justify-between" data-animate="fade-up" data-stagger-item>
        <div class="order-1 md:w-[42%] md:text-right">
          <h3
            class="text-foreground group-hover:text-tomato mb-2 font-serif text-2xl font-medium transition-colors"
          >
            3. KDS Cocina
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Las comandas aparecen en la pantalla de cocina ordenadas por prioridad. Cero gritos,
            cero errores.
          </p>
        </div>
        <div class="relative order-2 my-4 flex justify-center md:my-0 md:w-[16%]">
          <div
            class="bg-card border-border group-hover:border-tomato/50 z-10 flex h-12 w-12 items-center justify-center rounded-2xl border shadow-sm transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_var(--color-tomato)]"
          >
            <ChefHat class="text-tomato h-5 w-5" />
          </div>
        </div>
        <div
          class="bg-card/50 border-border/50 group-hover:bg-card group-hover:border-tomato/20 order-3 rounded-2xl border p-6 backdrop-blur-sm transition-all duration-300 md:w-[42%]"
        >
          <div
            class="flex gap-2 overflow-hidden opacity-60 transition-opacity group-hover:opacity-100"
          >
            <div
              class="bg-card h-24 w-24 shrink-0 rounded border border-l-4 border-l-orange-400 shadow-sm"
            >
            </div>
            <div
              class="bg-card h-24 w-24 shrink-0 rounded border border-l-4 border-l-green-400 shadow-sm"
            >
            </div>
          </div>
        </div>
      </div>

      <!-- Step 4: Right -->
      <div class="group md:flex md:items-center md:justify-between" data-animate="fade-up" data-stagger-item>
        <div class="order-1 md:order-3 md:w-[42%]">
          <h3
            class="text-foreground group-hover:text-basil mb-2 font-serif text-2xl font-medium transition-colors"
          >
            4. QR & Pago
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            El cliente escanea el QR, divide la cuenta (Split) y paga con Apple Pay / Google Pay sin
            esperar al camarero.
          </p>
        </div>
        <div class="relative order-2 my-4 flex justify-center md:my-0 md:w-[16%]">
          <div
            class="bg-card border-border group-hover:border-basil/50 z-10 flex h-12 w-12 items-center justify-center rounded-2xl border shadow-sm transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_var(--color-basil)]"
          >
            <QrCode class="text-basil h-5 w-5" />
          </div>
        </div>
        <div
          class="bg-card/50 border-border/50 group-hover:bg-card group-hover:border-basil/20 order-3 rounded-2xl border p-6 backdrop-blur-sm transition-all duration-300 md:order-1 md:w-[42%] md:text-right"
        >
          <div class="flex justify-end opacity-60 transition-opacity group-hover:opacity-100">
            <div class="h-16 w-16 rounded-lg bg-white p-1 shadow-sm">
              <div class="h-full w-full bg-black"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Final Flow Arrow -->
    <div class="mt-12 flex justify-center md:mt-16">
      <div
        class="text-muted-foreground/50 flex animate-pulse items-center gap-2 text-sm font-medium tracking-widest uppercase"
      >
        <span>Ciclo completado</span>
        <ArrowRight class="h-4 w-4" />
      </div>
    </div>
  </div>
</Section>
