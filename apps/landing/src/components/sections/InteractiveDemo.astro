---
import Card from '../ui/Card.astro';
import CardContent from '../ui/CardContent.astro';
import { MapPin, ClipboardList, ChefHat, QrCode, Users, CheckCircle } from '@lucide/astro';
---

<section class="demo-section bg-secondary/30 py-32" id="demo">
  <div class="container-landing">
    <!-- Section header -->
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-6 font-serif text-5xl font-bold text-balance sm:text-6xl">
        Así funciona Tally, paso a paso
      </h2>
      <p class="text-muted-foreground text-xl text-balance">
        Del primer click a la cuenta pagada, en tiempo real.
      </p>
    </div>

    <!-- Progress bar -->
    <div class="bg-muted mb-12 h-2 w-full overflow-hidden rounded-full">
      <div
        class="demo-progress-bar bg-primary h-full rounded-full transition-all duration-500"
        style="width: 16.66%"
      >
      </div>
    </div>

    <!-- Horizontal scroll container (mobile) / Grid (desktop) -->
    <div class="scrollbar-hide -mx-4 overflow-x-auto px-4 pb-8 sm:overflow-visible">
      <div
        class="demo-horizontal-container flex min-w-max gap-6 sm:grid sm:min-w-0 sm:grid-cols-2 lg:grid-cols-3"
      >
        <!-- Step 1 -->
        <Card variant="elevated" class="demo-card w-80 shrink-0 sm:w-auto">
          <CardContent class="py-8 text-center">
            <div
              class="bg-primary/10 mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl"
            >
              <MapPin class="text-primary h-10 w-10" />
            </div>
            <div class="mb-2 font-serif text-xl font-semibold">1. Mapa de mesas</div>
            <p class="text-muted-foreground">
              El camarero ve el mapa del local en tiempo real. Selecciona la mesa.
            </p>
          </CardContent>
        </Card>

        <!-- Step 2 -->
        <Card variant="elevated" class="demo-card w-80 shrink-0 sm:w-auto">
          <CardContent class="py-8 text-center">
            <div
              class="bg-primary/10 mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl"
            >
              <ClipboardList class="text-primary h-10 w-10" />
            </div>
            <div class="mb-2 font-serif text-xl font-semibold">2. Tomar comanda</div>
            <p class="text-muted-foreground">
              Añade productos del menú con un tap. Todo sincroniza offline.
            </p>
          </CardContent>
        </Card>

        <!-- Step 3 -->
        <Card variant="elevated" class="demo-card w-80 shrink-0 sm:w-auto">
          <CardContent class="py-8 text-center">
            <div
              class="bg-primary/10 mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl"
            >
              <ChefHat class="text-primary h-10 w-10" />
            </div>
            <div class="mb-2 font-serif text-xl font-semibold">3. Cocina recibe</div>
            <p class="text-muted-foreground">
              Comandas aparecen en pantalla de cocina al instante. Sin papeles.
            </p>
          </CardContent>
        </Card>

        <!-- Step 4 -->
        <Card variant="elevated" class="demo-card w-80 shrink-0 sm:w-auto">
          <CardContent class="py-8 text-center">
            <div
              class="bg-primary/10 mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl"
            >
              <QrCode class="text-primary h-10 w-10" />
            </div>
            <div class="mb-2 font-serif text-xl font-semibold">4. Genera QR</div>
            <p class="text-muted-foreground">
              Un tap genera el QR de la cuenta. Clientes escanean desde su móvil.
            </p>
          </CardContent>
        </Card>

        <!-- Step 5 -->
        <Card variant="elevated" class="demo-card w-80 shrink-0 sm:w-auto">
          <CardContent class="py-8 text-center">
            <div
              class="bg-primary/10 mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl"
            >
              <Users class="text-primary h-10 w-10" />
            </div>
            <div class="mb-2 font-serif text-xl font-semibold">5. Split inteligente</div>
            <p class="text-muted-foreground">
              Cada comensal elige qué pagó. Calcula propinas y divide automático.
            </p>
          </CardContent>
        </Card>

        <!-- Step 6 -->
        <Card variant="elevated" class="demo-card w-80 shrink-0 sm:w-auto">
          <CardContent class="py-8 text-center">
            <div
              class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl bg-[var(--basil)]/10"
            >
              <CheckCircle class="h-10 w-10 text-[var(--basil)]" />
            </div>
            <div class="mb-2 font-serif text-xl font-semibold">6. Listo</div>
            <p class="text-muted-foreground">
              Todo pagado, ticket emitido. Mesa lista para el siguiente turno.
            </p>
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
