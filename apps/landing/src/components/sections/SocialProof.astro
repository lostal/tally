---
import Section from '../ui/Section.astro';
import Badge from '../ui/Badge.astro';
---

<Section id="social-proof" className="bg-secondary/5">
  <div class="mx-auto mb-16 max-w-3xl text-center">
    <h2
      class="text-foreground mb-6 font-serif text-4xl font-medium tracking-tight text-balance sm:text-5xl"
      data-animate="fade-up"
    >
      Ya confían en Tally
    </h2>
    <p class="text-muted-foreground text-xl text-balance" data-animate="fade-up">
      Desde cafeterías boutique hasta cadenas en expansión.
    </p>
  </div>

  <!-- Marquee with fade masks -->
  <div class="mask-linear-fade relative mb-24 w-full overflow-hidden">
    <div class="animate-scroll-infinite flex w-max gap-12">
      {
        [...Array(2)].map(() => (
          <div class="flex items-center gap-12">
            {[
              'La Taberna del Puerto',
              'Café Modernist',
              'Pizzería Napoli',
              'Sushi Zen',
              'Burger House',
              'Paella & Mar',
              'Bistro 1984',
              'El Café de la Esquina',
            ].map((name) => (
              <div class="text-muted-foreground/40 hover:text-foreground cursor-default font-serif text-2xl font-bold whitespace-nowrap transition-colors">
                {name}
              </div>
            ))}
          </div>
        ))
      }
    </div>
    <!-- Gradients for fade effect -->
    <div class="from-background absolute inset-y-0 left-0 z-10 w-24 bg-linear-to-r to-transparent">
    </div>
    <div class="from-background absolute inset-y-0 right-0 z-10 w-24 bg-linear-to-l to-transparent">
    </div>
  </div>

  <!-- Testimonials Grid -->
  <div class="grid gap-8 md:grid-cols-3" data-stagger="150">
    <!-- MASONRY CARDS -->
    <div
      class="group bg-card border-border/50 relative rounded-3xl border p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
      data-animate="fade-up"
      data-stagger-item
      data-tilt="1.5"
    >
      <div class="text-tomato mb-4 flex gap-1">
        {
          [...Array(5)].map(() => (
            <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))
        }
      </div>
      <p class="text-foreground mb-6 text-lg leading-relaxed">
        "Nuestros camareros tardaban 10 minutos por mesa. Ahora son 2. <span
          class="text-foreground rounded bg-(--tomato)/10 px-1 font-semibold"
          >Tally se pagó solo</span
        > en la primera semana."
      </p>
      <div class="flex items-center gap-4">
        <div
          class="bg-muted text-muted-foreground flex h-10 w-10 items-center justify-center rounded-full font-serif font-bold"
        >
          CM
        </div>
        <div>
          <div class="font-medium">Carlos M.</div>
          <div class="text-muted-foreground text-sm">La Taberna del Puerto</div>
        </div>
      </div>
    </div>

    <div
      class="group bg-card border-border/50 relative rounded-3xl border p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
      data-animate="fade-up"
      data-stagger-item
      data-tilt="1.5"
    >
      <div class="text-tomato mb-4 flex gap-1">
        {
          [...Array(5)].map(() => (
            <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))
        }
      </div>
      <p class="text-foreground mb-6 text-lg leading-relaxed">
        "El split de cuenta es mágico. Grupos grandes ya no son un problema. <span
          class="text-foreground rounded bg-(--blueberry)/10 px-1 font-semibold">Propinas +40%</span
        >."
      </p>
      <div class="flex items-center gap-4">
        <div
          class="bg-muted text-muted-foreground flex h-10 w-10 items-center justify-center rounded-full font-serif font-bold"
        >
          AR
        </div>
        <div>
          <div class="font-medium">Ana R.</div>
          <div class="text-muted-foreground text-sm">Café Modernist</div>
        </div>
      </div>
    </div>

    <div
      class="group bg-card border-border/50 relative rounded-3xl border p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
      data-animate="fade-up"
      data-stagger-item
      data-tilt="1.5"
    >
      <div class="text-tomato mb-4 flex gap-1">
        {
          [...Array(5)].map(() => (
            <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))
        }
      </div>
      <p class="text-foreground mb-6 text-lg leading-relaxed">
        "Implementación en 1 hora. Sin formación necesaria, el equipo lo usó desde el primer día."
      </p>
      <div class="flex items-center gap-4">
        <div
          class="bg-muted text-muted-foreground flex h-10 w-10 items-center justify-center rounded-full font-serif font-bold"
        >
          MS
        </div>
        <div>
          <div class="font-medium">Miguel S.</div>
          <div class="text-muted-foreground text-sm">Pizzería Napoli</div>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  @keyframes scroll-infinite {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-scroll-infinite {
    animation: scroll-infinite 40s linear infinite;
  }

  .animate-scroll-infinite:hover {
    animation-play-state: paused;
  }
</style>
