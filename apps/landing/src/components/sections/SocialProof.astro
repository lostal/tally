---
import Badge from '../ui/Badge.astro';
---

<section class="bg-secondary/30 py-32">
  <div class="container-landing">
    <!-- Section header -->
    <div class="mx-auto mb-20 max-w-3xl text-center">
      <h2 class="mb-6 font-serif text-5xl font-bold text-balance sm:text-6xl">
        Ya confían en Tally
      </h2>
      <p class="text-muted-foreground text-xl text-balance">
        Desde cafeterías boutique hasta cadenas de restaurantes.
      </p>
    </div>

    <!-- Carousel of logos (infinite loop) -->
    <div class="relative overflow-hidden">
      <div class="animate-scroll-infinite flex gap-12">
        <!-- Logo placeholders (repeat for seamless loop) -->
        {
          [
            'La Taberna del Puerto',
            'Café Modernist',
            'Pizzería Napoli',
            'Sushi Zen',
            'Burger House',
            'Paella & Mar',
            'La Taberna del Puerto',
            'Café Modernist',
          ].map((name) => (
            <div class="bg-card border-border flex min-w-[200px] shrink-0 items-center justify-center rounded-lg border px-8 py-6">
              <div class="text-foreground/60 font-serif text-xl font-semibold whitespace-nowrap">
                {name}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Testimonials -->
    <div class="mt-20 grid gap-8 md:grid-cols-3">
      <!-- Testimonial 1 -->
      <div class="bg-card border-border rounded-xl border p-8">
        <div class="mb-4 flex gap-1">
          {
            [...Array(5)].map(() => (
              <svg class="h-5 w-5 text-[var(--tomato)]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))
          }
        </div>
        <p class="text-muted-foreground mb-4">
          "Nuestros camareros tardaban 10 minutos por mesa. Ahora son 2. Tally se pagó solo en la
          primera semana."
        </p>
        <div class="font-semibold">Carlos M.</div>
        <div class="text-muted-foreground text-sm">Propietario, La Taberna del Puerto</div>
      </div>

      <!-- Testimonial 2 -->
      <div class="bg-card border-border rounded-xl border p-8">
        <div class="mb-4 flex gap-1">
          {
            [...Array(5)].map(() => (
              <svg class="h-5 w-5 text-[var(--tomato)]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))
          }
        </div>
        <p class="text-muted-foreground mb-4">
          "El split de cuenta es mágico. Grupos grandes ya no son un problema. Aumentamos propinas
          un 40%."
        </p>
        <div class="font-semibold">Ana R.</div>
        <div class="text-muted-foreground text-sm">Gerente, Café Modernist</div>
      </div>

      <!-- Testimonial 3 -->
      <div class="bg-card border-border rounded-xl border p-8">
        <div class="mb-4 flex gap-1">
          {
            [...Array(5)].map(() => (
              <svg class="h-5 w-5 text-[var(--tomato)]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))
          }
        </div>
        <p class="text-muted-foreground mb-4">
          "Implementación en 1 hora. Sin formación necesaria, el equipo lo usó desde el primer día.
          Increíble."
        </p>
        <div class="font-semibold">Miguel S.</div>
        <div class="text-muted-foreground text-sm">Chef Propietario, Pizzería Napoli</div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes scroll-infinite {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-scroll-infinite {
    animation: scroll-infinite 30s linear infinite;
  }

  .animate-scroll-infinite:hover {
    animation-play-state: paused;
  }
</style>
