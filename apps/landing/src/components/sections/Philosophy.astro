---

---

<section class="bg-secondary/30 py-32">
  <div class="container-landing">
    <div class="mx-auto max-w-4xl space-y-12 text-center">
      <!-- Visual placeholder (illustration of waiter with tablet) -->
      <div class="relative mx-auto mb-12 aspect-square w-full max-w-md">
        <div class="from-primary/5 absolute inset-0 rounded-3xl bg-linear-to-br to-transparent">
        </div>
        <svg
          class="h-full w-full p-12"
          viewBox="0 0 200 200"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Simple minimalist illustration: waiter with tablet -->
          <!-- Person -->
          <circle cx="100" cy="60" r="20" fill="var(--primary)" opacity="0.2"></circle>
          <rect x="85" y="85" width="30" height="60" rx="5" fill="var(--primary)" opacity="0.3"
          ></rect>

          <!-- Tablet in hand -->
          <rect x="110" y="100" width="40" height="30" rx="3" fill="var(--primary)" opacity="0.6"
          ></rect>
          <rect x="115" y="105" width="30" height="20" rx="2" fill="var(--card)"></rect>

          <!-- Checkmarks on tablet screen -->
          <path
            d="M120 112 L123 115 L128 108"
            stroke="var(--basil)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>
          <path
            d="M120 118 L123 121 L128 114"
            stroke="var(--basil)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>
        </svg>
      </div>

      <!-- Content -->
      <h2 class="font-serif text-6xl font-bold text-balance sm:text-7xl">
        Waiter-First,<br />Customer-Centric
      </h2>

      <p class="text-muted-foreground mx-auto max-w-[65ch] text-xl leading-relaxed sm:text-2xl">
        Diseñado para personas reales en entornos reales. Sin WiFi, sin problemas. Sin curva de
        aprendizaje, sin fricción. Tu equipo aprende en 5 minutos, tus clientes pagan en 30
        segundos.
      </p>

      <!-- Stats -->
      <div class="grid gap-8 pt-12 sm:grid-cols-3">
        <div>
          <div class="font-serif text-5xl font-bold text-[var(--basil)] tabular-nums">5min</div>
          <p class="text-muted-foreground mt-2">Tiempo de formación</p>
        </div>
        <div>
          <div class="font-serif text-5xl font-bold text-[var(--blueberry)] tabular-nums">30s</div>
          <p class="text-muted-foreground mt-2">De QR a pago completo</p>
        </div>
        <div>
          <div class="font-serif text-5xl font-bold text-[var(--tomato)] tabular-nums">100%</div>
          <p class="text-muted-foreground mt-2">Offline-first</p>
        </div>
      </div>
    </div>
  </div>
</section>
