---
import Section from '../ui/Section.astro';
---

<Section id="philosophy" className="relative overflow-hidden">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-24">
    <!-- Visual / Abstract Art -->
    <div
      class="relative order-last mx-auto aspect-square w-full max-w-md lg:order-first lg:max-w-none"
      data-animate="scale"
    >
      <!-- Animated gradient background - NO BLUR for WebKit performance -->
      <div
        class="from-tomato via-espresso to-blueberry absolute inset-0 rounded-full bg-linear-to-tr opacity-15"
      >
      </div>

      <!-- Main visual container -->
      <div class="relative h-full w-full">
        <!-- Middle glass container - NO BLUR for WebKit performance -->
        <div
          class="absolute inset-8 flex items-center justify-center overflow-hidden rounded-3xl border border-white/10 bg-white/5 shadow-2xl"
        >
          <div
            class="absolute inset-0 hidden bg-[url('/noise.svg')] opacity-20 mix-blend-overlay md:block"
          >
          </div>

          <!-- Three stacked cards with stagger animation -->
          <div class="relative h-full w-full p-8" data-stagger="150">
            <!-- Card 1 - Background -->
            <div
              class="bg-card/80 border-border/50 absolute top-12 right-8 left-8 h-48 rounded-2xl border shadow-xl transition-transform hover:scale-105"
              style="transform: rotate(-6deg);"
              data-stagger-item
            >
              <div class="flex h-full flex-col justify-between p-4">
                <div class="bg-tomato/20 h-10 w-10 rounded-xl"></div>
                <div class="space-y-2">
                  <div class="bg-muted/50 h-3 w-3/4 rounded"></div>
                  <div class="bg-muted/30 h-3 w-1/2 rounded"></div>
                </div>
              </div>
            </div>

            <!-- Card 2 - Middle -->
            <div
              class="bg-card border-border/50 absolute top-16 right-12 left-12 h-48 rounded-2xl border shadow-xl transition-transform hover:scale-105"
              style="transform: rotate(3deg);"
              data-stagger-item
            >
              <div class="flex h-full flex-col justify-between p-4">
                <div class="bg-blueberry/20 h-10 w-10 rounded-xl"></div>
                <div class="space-y-2">
                  <div class="bg-muted/50 h-3 w-2/3 rounded"></div>
                  <div class="bg-muted/30 h-3 w-1/2 rounded"></div>
                </div>
              </div>
            </div>

            <!-- Card 3 - Front (Interactive) -->
            <div
              class="bg-card border-primary/20 absolute top-20 right-16 left-16 h-48 rounded-2xl border shadow-2xl transition-all hover:scale-105 hover:shadow-[0_0_40px_-10px_var(--primary)]"
              data-stagger-item
            >
              <div class="flex h-full flex-col justify-between p-5">
                <div
                  class="bg-basil/20 text-basil flex h-12 w-12 items-center justify-center rounded-xl"
                >
                  <svg
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <div class="space-y-2">
                  <div class="bg-muted/50 h-3 w-3/4 rounded"></div>
                  <div class="bg-muted/40 h-3 w-2/3 rounded"></div>
                  <div class="bg-muted/30 h-3 w-1/2 rounded"></div>
                </div>
                <div class="bg-primary/10 h-10 rounded-lg"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Editorial Content -->
    <div class="space-y-12">
      <div data-animate="fade-up">
        <h2
          class="mb-8 font-serif text-5xl leading-[1.1] font-medium text-balance sm:text-6xl md:text-7xl"
        >
          Waiter-First. <br />
          <span class="text-muted-foreground italic">Customer-Centric.</span>
        </h2>
        <p class="text-muted-foreground text-xl leading-relaxed text-balance">
          Diseñado para el caos del servicio real. Sin WiFi, sin pausas. Sin curva de aprendizaje.
          Tu equipo vuela, tus clientes disfrutan.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 pt-8 sm:grid-cols-3" data-stagger="100">
        <div data-animate="fade-up" data-stagger-item>
          <div
            class="text-basil mb-2 font-serif text-4xl font-bold tabular-nums"
            data-count="5"
            data-suffix="m"
            data-duration="1500"
          >
            5m
          </div>
          <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">Formación</p>
        </div>
        <div data-animate="fade-up" data-stagger-item>
          <div
            class="text-blueberry mb-2 font-serif text-4xl font-bold tabular-nums"
            data-count="30"
            data-suffix="s"
            data-duration="1500"
          >
            30s
          </div>
          <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">Pago QR</p>
        </div>
        <div data-animate="fade-up" data-stagger-item>
          <div
            class="text-tomato mb-2 font-serif text-4xl font-bold tabular-nums"
            data-count="100"
            data-suffix="%"
            data-duration="1500"
          >
            100%
          </div>
          <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">Offline</p>
        </div>
      </div>
    </div>
  </div>
</Section>
