---
import Section from '../ui/Section.astro';
---

<Section id="philosophy" className="relative overflow-hidden">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-24">
    <!-- Visual / Abstract Art -->
    <div
      class="relative order-last mx-auto aspect-square w-full max-w-md lg:order-first lg:max-w-none"
    >
      <div
        class="from-tomato via-espresso to-blueberry absolute inset-0 rounded-full bg-linear-to-tr opacity-20 blur-3xl"
      >
      </div>
      <div
        class="relative flex h-full w-full items-center justify-center overflow-hidden rounded-full border border-white/10 bg-white/5 backdrop-blur-2xl"
      >
        <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-20 mix-blend-overlay"></div>

        <!-- Abstract UI Representation - Hidden on mobile -->
        <div
          class="bg-background border-border/50 relative hidden h-80 w-64 skew-y-6 rounded-2xl border shadow-2xl transition-transform duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] hover:skew-y-0 md:flex"
        >
          <div class="flex h-full w-full flex-col gap-4 p-6">
            <div class="mb-4 h-12 w-12 rounded-full bg-(--tomato)/20"></div>
            <div class="bg-muted/50 h-4 w-3/4 rounded"></div>
            <div class="bg-muted/30 h-4 w-1/2 rounded"></div>
            <div class="flex-1"></div>
            <div class="bg-primary/10 h-12 w-full rounded-xl"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Editorial Content -->
    <div class="space-y-12">
      <div>
        <h2
          class="mb-8 font-serif text-5xl leading-[1.1] font-medium text-balance sm:text-6xl md:text-7xl"
        >
          Waiter-First. <br />
          <span class="text-muted-foreground italic">Customer-Centric.</span>
        </h2>
        <p class="text-muted-foreground text-xl leading-relaxed text-balance">
          Diseñado para el caos del servicio real. Sin WiFi, sin pausas. Sin curva de aprendizaje.
          Tu equipo vuela, tus clientes disfrutan.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 pt-8 sm:grid-cols-3">
        <div>
          <div class="text-basil mb-2 font-serif text-4xl font-bold tabular-nums">5m</div>
          <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">Formación</p>
        </div>
        <div>
          <div class="text-blueberry mb-2 font-serif text-4xl font-bold tabular-nums">30s</div>
          <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">Pago QR</p>
        </div>
        <div>
          <div class="text-tomato mb-2 font-serif text-4xl font-bold tabular-nums">100%</div>
          <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">Offline</p>
        </div>
      </div>
    </div>
  </div>
</Section>
