---
import Section from '../ui/Section.astro';
import { Utensils, ChefHat, BarChart3, ChevronRight } from '@lucide/astro';
---

<Section id="features" className="relative overflow-hidden">
  <div class="mx-auto mb-20 max-w-3xl md:text-center">
    <h2
      class="text-foreground mb-6 font-serif text-4xl font-medium tracking-tight text-balance sm:text-5xl md:text-6xl"
      data-animate="fade-up"
    >
      Diseñado para cada rol
    </h2>
    <p class="text-muted-foreground text-xl text-balance" data-animate="fade-up">
      Interfaces específicas que tu personal dominará en minutos.
    </p>
  </div>

  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <!-- Left Column: Controls -->
    <div class="space-y-4" id="feature-controls">
      <!-- Item 1 -->
      <button
        class="feature-btn group border-border/50 bg-card/30 hover:bg-card/80 data-[active=true]:border-primary/50 data-[active=true]:bg-card w-full rounded-2xl border p-6 text-left transition-all duration-300 data-[active=true]:shadow-lg"
        data-target="feature-1"
        data-active="true"
      >
        <div class="flex items-start gap-4">
          <div class="mt-1 shrink-0">
            <div
              class="bg-tomato/10 text-tomato group-data-[active=true]:bg-tomato flex h-10 w-10 items-center justify-center rounded-lg transition-colors group-data-[active=true]:text-white"
            >
              <Utensils class="h-5 w-5" />
            </div>
          </div>
          <div>
            <h3 class="group-data-[active=true]:text-primary mb-1 font-serif text-lg font-medium">
              Camareros
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              TPV rápido. Comandas en 3 taps y sincronización offline.
            </p>
          </div>
          <ChevronRight
            class="text-muted-foreground ml-auto h-5 w-5 opacity-0 transition-opacity group-data-[active=true]:opacity-100"
          />
        </div>
      </button>

      <!-- Item 2 -->
      <button
        class="feature-btn group border-border/50 bg-card/30 hover:bg-card/80 data-[active=true]:border-primary/50 data-[active=true]:bg-card w-full rounded-2xl border p-6 text-left transition-all duration-300 data-[active=true]:shadow-lg"
        data-target="feature-2"
      >
        <div class="flex items-start gap-4">
          <div class="mt-1 shrink-0">
            <div
              class="bg-blueberry/10 text-blueberry group-data-[active=true]:bg-blueberry flex h-10 w-10 items-center justify-center rounded-lg transition-colors group-data-[active=true]:text-white"
            >
              <ChefHat class="h-5 w-5" />
            </div>
          </div>
          <div>
            <h3 class="group-data-[active=true]:text-primary mb-1 font-serif text-lg font-medium">
              Cocina
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              KDS en tiempo real. Priorización automática y cero papeles.
            </p>
          </div>
          <ChevronRight
            class="text-muted-foreground ml-auto h-5 w-5 opacity-0 transition-opacity group-data-[active=true]:opacity-100"
          />
        </div>
      </button>

      <!-- Item 3 -->
      <button
        class="feature-btn group border-border/50 bg-card/30 hover:bg-card/80 data-[active=true]:border-primary/50 data-[active=true]:bg-card w-full rounded-2xl border p-6 text-left transition-all duration-300 data-[active=true]:shadow-lg"
        data-target="feature-3"
      >
        <div class="flex items-start gap-4">
          <div class="mt-1 shrink-0">
            <div
              class="bg-basil/10 text-basil group-data-[active=true]:bg-basil flex h-10 w-10 items-center justify-center rounded-lg transition-colors group-data-[active=true]:text-white"
            >
              <BarChart3 class="h-5 w-5" />
            </div>
          </div>
          <div>
            <h3 class="group-data-[active=true]:text-primary mb-1 font-serif text-lg font-medium">
              Gestión
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Control total. Ventas en vivo, stock y rendimiento de personal.
            </p>
          </div>
          <ChevronRight
            class="text-muted-foreground ml-auto h-5 w-5 opacity-0 transition-opacity group-data-[active=true]:opacity-100"
          />
        </div>
      </button>
    </div>

    <!-- Right Column: Visuals -->
    <div
      class="border-border/50 bg-card/50 relative aspect-square overflow-hidden rounded-3xl border shadow-2xl backdrop-blur-xl md:aspect-video lg:aspect-square xl:aspect-4/3"
    >
      <!-- Feature 1 Visual -->
      <div
        id="feature-1-visual"
        class="feature-visual absolute inset-0 flex flex-col p-8 opacity-100 transition-opacity duration-500"
      >
        <div class="from-tomato/5 absolute inset-0 bg-linear-to-br to-transparent"></div>
        <div
          class="bg-background border-border/50 relative flex h-full w-full flex-col overflow-hidden rounded-xl border shadow-sm"
        >
          <!-- Mock UI Header -->
          <div class="border-border/50 flex h-12 items-center gap-2 border-b px-4">
            <div class="h-3 w-3 rounded-full bg-red-400/50"></div>
            <div class="h-3 w-3 rounded-full bg-yellow-400/50"></div>
            <div class="h-3 w-3 rounded-full bg-green-400/50"></div>
          </div>
          <!-- Mock UI Body -->
          <div class="bg-muted/5 grid flex-1 grid-cols-3 gap-4 p-4">
            <div class="col-span-2 grid grid-cols-2 content-start gap-3">
              <div class="bg-card border-border/50 h-24 rounded-lg border shadow-sm"></div>
              <div class="bg-card border-border/50 h-24 rounded-lg border shadow-sm"></div>
              <div class="bg-card border-border/50 h-24 rounded-lg border shadow-sm"></div>
              <div class="bg-card border-border/50 h-24 rounded-lg border shadow-sm"></div>
              <div class="bg-card border-border/50 h-24 rounded-lg border shadow-sm"></div>
              <div class="bg-card border-border/50 h-24 rounded-lg border shadow-sm"></div>
            </div>
            <div class="bg-card border-border/50 h-full space-y-3 rounded-lg border p-3 shadow-sm">
              <div class="bg-muted/50 h-8 w-full rounded"></div>
              <div class="bg-muted/30 h-4 w-2/3 rounded"></div>
              <div class="flex-1"></div>
              <div class="bg-tomato/20 h-12 w-full rounded"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 2 Visual -->
      <div
        id="feature-2-visual"
        class="feature-visual pointer-events-none absolute inset-0 flex flex-col p-8 opacity-0 transition-opacity duration-500"
      >
        <div class="from-blueberry/5 absolute inset-0 bg-linear-to-br to-transparent"></div>
        <!-- KDS Mockup -->
        <div
          class="bg-background border-border/50 relative flex h-full w-full flex-col overflow-hidden rounded-xl border shadow-sm"
        >
          <div
            class="border-border/50 bg-blueberry/5 flex h-12 items-center justify-between border-b px-4"
          >
            <span class="text-blueberry font-mono text-xs font-bold">KDS DISPLAY</span>
            <div class="flex gap-2">
              <div class="bg-background rounded border px-2 py-1 text-xs">12:30</div>
            </div>
          </div>
          <div class="bg-muted/10 grid flex-1 grid-cols-3 gap-4 p-4">
            <div
              class="bg-card space-y-2 rounded-lg border border-l-4 border-l-orange-400 p-3 shadow-sm"
            >
              <div class="flex justify-between text-xs font-bold">
                <span>Mesa 4</span><span>12:05</span>
              </div>
              <div class="space-y-1 text-xs">
                <div class="bg-muted/30 rounded p-1">Burger Clasica</div>
                <div class="bg-muted/30 rounded p-1">Patatas Fritas</div>
              </div>
            </div>
            <div
              class="bg-card space-y-2 rounded-lg border border-l-4 border-l-green-400 p-3 shadow-sm"
            >
              <div class="flex justify-between text-xs font-bold">
                <span>Mesa 2</span><span>12:12</span>
              </div>
              <div class="space-y-1 text-xs">
                <div class="bg-muted/30 rounded p-1">Ensalada César</div>
              </div>
            </div>
            <div
              class="bg-card space-y-2 rounded-lg border border-l-4 border-l-green-400 p-3 shadow-sm"
            >
              <div class="flex justify-between text-xs font-bold">
                <span>Mesa 8</span><span>12:15</span>
              </div>
              <div class="space-y-1 text-xs">
                <div class="bg-muted/30 rounded p-1">Pasta Carbonara</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 3 Visual -->
      <div
        id="feature-3-visual"
        class="feature-visual pointer-events-none absolute inset-0 flex flex-col p-8 opacity-0 transition-opacity duration-500"
      >
        <div class="from-basil/5 absolute inset-0 bg-linear-to-br to-transparent"></div>
        <!-- Charts Mockup -->
        <div
          class="bg-background border-border/50 relative flex h-full w-full flex-col space-y-4 overflow-hidden rounded-xl border p-6 shadow-sm"
        >
          <div class="grid grid-cols-2 gap-4">
            <div
              class="bg-muted/10 border-border/50 relative flex h-24 flex-col justify-end overflow-hidden rounded-lg border p-2"
            >
              <div
                class="bg-basil/10 absolute right-0 bottom-0 left-0 h-16"
                style="clip-path: polygon(0 100%, 0 40%, 30% 60%, 60% 30%, 100% 10%, 100% 100%)"
              >
              </div>
              <span class="relative font-serif text-2xl font-bold">€2.4k</span>
              <span class="text-muted-foreground relative text-xs">Ventas hoy</span>
            </div>
            <div class="bg-muted/10 border-border/50 h-24 rounded-lg border p-2">
              <span class="font-serif text-2xl font-bold">84</span>
              <span class="text-muted-foreground block text-xs">Comandas</span>
            </div>
          </div>
          <div class="bg-muted/10 border-border/50 relative flex-1 rounded-lg border p-4">
            <div class="absolute inset-x-4 top-8 bottom-4 flex items-end justify-between gap-1">
              <div class="bg-basil/20 h-[40%] w-full rounded-t"></div>
              <div class="bg-basil/40 h-[60%] w-full rounded-t"></div>
              <div class="bg-basil/30 h-[30%] w-full rounded-t"></div>
              <div class="bg-basil/60 h-[80%] w-full rounded-t"></div>
              <div class="bg-basil/50 h-[50%] w-full rounded-t"></div>
              <div class="bg-basil/80 h-[90%] w-full rounded-t"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  // Simple vanilla JS for the features tabs
  document.addEventListener('astro:page-load', () => {
    const featureSection = document.getElementById('features');
    if (!featureSection) return;

    const buttons = featureSection.querySelectorAll('.feature-btn');
    const visuals = featureSection.querySelectorAll('.feature-visual');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        // Update buttons
        buttons.forEach((b) => b.setAttribute('data-active', 'false'));
        btn.setAttribute('data-active', 'true');

        // Update visuals
        visuals.forEach((v) => {
          if (v.id === `${targetId}-visual`) {
            v.classList.remove('opacity-0', 'pointer-events-none');
            v.classList.add('opacity-100');
          } else {
            v.classList.remove('opacity-100');
            v.classList.add('opacity-0', 'pointer-events-none');
          }
        });
      });
    });
  });
</script>
