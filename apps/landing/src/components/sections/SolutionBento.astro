---
import Section from '../ui/Section.astro';
import { Smartphone, BarChart3, Globe, Zap, ShieldCheck } from '@lucide/astro';
---

<Section id="solution">
  <div class="mx-auto mb-16 max-w-3xl text-center">
    <h2
      class="text-foreground mb-6 font-serif text-4xl font-medium tracking-tight text-balance sm:text-5xl"
    >
      Todo lo que necesitas, <br class="hidden sm:block" /> en un solo lugar.
    </h2>
    <p class="text-muted-foreground text-xl text-balance">
      Olvídate de pagar 5 herramientas distintas. Tally unifica tu operativa.
    </p>
  </div>

  <div class="grid auto-rows-[minmax(200px,auto)] grid-cols-1 gap-6 md:grid-cols-3">
    <!-- Card 1: Main Dashboard Feature (Large) -->
    <div
      class="group border-border/50 bg-card/30 hover:bg-card relative overflow-hidden rounded-3xl border p-8 transition-all duration-500 hover:shadow-xl md:col-span-2"
    >
      <div
        class="from-tomato/5 absolute inset-0 bg-linear-to-br to-transparent opacity-0 transition-opacity group-hover:opacity-100"
      >
      </div>

      <div class="relative z-10 flex h-full flex-col">
        <div class="mb-4 flex items-center gap-3">
          <div
            class="bg-tomato/10 text-tomato flex h-10 w-10 items-center justify-center rounded-lg transition-transform group-hover:scale-110"
          >
            <Zap class="h-6 w-6" />
          </div>
          <h3 class="text-lg font-medium">TPV Ultrarrápido</h3>
        </div>
        <p class="text-muted-foreground mb-8 max-w-sm text-sm leading-relaxed">
          Diseñado para la velocidad. Toma pedidos, modifica platos y cobra en segundos. Interfaz
          optimizada para el caos del servicio.
        </p>

        <!-- Mock Visual -->
        <div
          class="bg-background border-border/50 relative w-full flex-1 overflow-hidden rounded-t-xl border-x border-t shadow-sm"
        >
          <div class="bg-muted/5 absolute inset-0 flex items-center justify-center">
            <span class="text-muted-foreground font-mono text-xs">APP INTERFACE PREVIEW</span>
          </div>
          <!-- Abstract UI representation -->
          <div class="grid grid-cols-3 gap-3 p-4 opacity-50">
            <div class="bg-muted/20 h-24 rounded"></div>
            <div class="bg-muted/20 h-24 rounded"></div>
            <div class="bg-muted/20 h-24 rounded"></div>
            <div class="bg-muted/20 h-24 rounded"></div>
            <div class="bg-muted/20 h-24 rounded"></div>
            <div class="bg-muted/20 h-24 rounded"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Mobile/QR (Tall) -->
    <div
      class="group border-border/50 bg-card/30 hover:bg-card relative overflow-hidden rounded-3xl border p-8 transition-all duration-500 hover:shadow-xl md:row-span-2"
    >
      <div
        class="from-blueberry/5 absolute inset-0 bg-linear-to-b to-transparent opacity-0 transition-opacity group-hover:opacity-100"
      >
      </div>

      <div class="relative z-10 flex h-full flex-col items-center text-center">
        <div
          class="bg-blueberry/10 text-blueberry mb-6 flex h-12 w-12 items-center justify-center rounded-2xl transition-transform group-hover:scale-110"
        >
          <Smartphone class="h-6 w-6" />
        </div>
        <h3 class="mb-3 text-xl font-medium">Tu carta en QR</h3>
        <p class="text-muted-foreground mb-8 text-sm leading-relaxed">
          Menú digital siempre actualizado. Los clientes piden y pagan desde su móvil. Aumenta la
          rotación de mesas un 20%.
        </p>

        <!-- Mock Phone -->
        <div
          class="bg-background border-foreground/10 relative mx-auto w-full max-w-[200px] flex-1 overflow-hidden rounded-t-[2.5rem] border-x-8 border-t-8 shadow-lg"
        >
          <div class="bg-foreground/10 mx-auto mb-4 h-4 w-1/2 rounded-b-xl"></div>
          <div class="space-y-3 p-4">
            <div class="bg-blueberry/5 h-32 rounded-xl"></div>
            <div class="bg-muted/10 h-10 rounded-lg"></div>
            <div class="bg-muted/10 h-10 rounded-lg"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 3: Analytics (Small) -->
    <div
      class="group border-border/50 bg-card/30 hover:bg-card relative overflow-hidden rounded-3xl border p-8 transition-all duration-500 hover:shadow-xl"
    >
      <div
        class="from-basil/5 absolute inset-0 bg-linear-to-tr to-transparent opacity-0 transition-opacity group-hover:opacity-100"
      >
      </div>
      <div class="relative z-10">
        <div class="mb-4 flex items-center justify-between">
          <div
            class="bg-basil/10 text-basil flex h-10 w-10 items-center justify-center rounded-lg transition-transform group-hover:scale-110"
          >
            <BarChart3 class="h-6 w-6" />
          </div>
          <span class="text-foreground font-serif text-2xl font-bold">+30%</span>
        </div>
        <h3 class="mb-2 text-lg font-medium">Rentabilidad</h3>
        <p class="text-muted-foreground text-sm">
          Control de stock real y escandallos automáticos.
        </p>
      </div>
    </div>

    <!-- Card 4: Cloud (Small) -->
    <div
      class="group border-border/50 bg-card/30 hover:bg-card relative overflow-hidden rounded-3xl border p-8 transition-all duration-500 hover:shadow-xl"
    >
      <div
        class="from-espresso/5 absolute inset-0 bg-linear-to-tr to-transparent opacity-0 transition-opacity group-hover:opacity-100"
      >
      </div>
      <div class="relative z-10">
        <div class="mb-4 flex items-center justify-between">
          <div
            class="bg-espresso/10 text-espresso flex h-10 w-10 items-center justify-center rounded-lg transition-transform group-hover:scale-110"
          >
            <Globe class="h-6 w-6" />
          </div>
          <span class="bg-muted/50 text-muted-foreground rounded px-2 py-1 font-mono text-xs"
            >CLOUD</span
          >
        </div>
        <h3 class="mb-2 text-lg font-medium">Desde cualquier lugar</h3>
        <p class="text-muted-foreground text-sm">
          Gestiona tu negocio desde el sofá o las Bahamas.
        </p>
      </div>
    </div>
  </div>
</Section>
