---
import Section from '../ui/Section.astro';
import { WifiOff, FileCheck, Lock, Zap, Database, Server } from '@lucide/astro';
---

<Section id="trust">
  <div class="mx-auto mb-16 max-w-3xl md:text-center">
    <h2
      class="text-foreground mb-4 font-serif text-4xl font-medium tracking-tight text-balance sm:text-5xl md:text-6xl"
    >
      Tecnología robusta
    </h2>
    <p class="text-muted-foreground text-xl text-balance">
      Construido para escalar. Seguridad bancaria y fiabilidad absoluta.
    </p>
  </div>

  <div class="grid auto-rows-[minmax(250px,auto)] grid-cols-1 gap-6 md:grid-cols-3">
    <!-- Card 1: Offline First (Large) -->
    <div
      class="group border-border/50 bg-card/30 hover:bg-card relative overflow-hidden rounded-3xl border p-8 transition-all duration-300 hover:shadow-xl md:col-span-2"
    >
      <div
        class="from-basil/5 absolute inset-0 bg-linear-to-br to-transparent opacity-0 transition-opacity group-hover:opacity-100"
      >
      </div>

      <div class="relative z-10 flex h-full flex-col items-start">
        <div
          class="bg-basil/10 text-basil mb-6 flex h-12 w-12 items-center justify-center rounded-2xl shadow-sm"
        >
          <WifiOff class="h-6 w-6" />
        </div>
        <h3 class="mb-3 font-serif text-2xl font-medium">Offline-First Engine</h3>
        <p class="text-muted-foreground max-w-md leading-relaxed">
          Tu restaurante nunca se detiene. Sincronización transparente con bases de datos locales
          (IndexedDB). Si cae internet, sigues vendiendo y la app sincroniza al volver.
        </p>

        <!-- Abstract Visual -->
        <div
          class="pointer-events-none absolute right-0 bottom-0 h-full w-1/3 opacity-10 transition-opacity group-hover:opacity-20"
        >
          <div
            class="h-full w-full bg-[repeating-linear-gradient(45deg,var(--color-basil),var(--color-basil)_10px,transparent_10px,transparent_20px)]"
          >
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Security (Tall/Standard) -->
    <div
      class="border-border/50 bg-card/30 hover:bg-card group relative flex flex-col justify-between overflow-hidden rounded-3xl border p-8 transition-all duration-300 hover:shadow-xl md:col-span-1"
    >
      <div
        class="from-espresso/5 absolute inset-0 bg-linear-to-bl to-transparent opacity-0 transition-opacity group-hover:opacity-100"
      >
      </div>
      <div>
        <div
          class="bg-espresso/10 text-espresso mb-6 flex h-12 w-12 items-center justify-center rounded-2xl shadow-sm"
        >
          <Lock class="h-6 w-6" />
        </div>
        <h3 class="mb-3 font-serif text-xl font-medium">Seguridad Enterprise</h3>
        <p class="text-muted-foreground text-sm">
          Aislamiento de datos con Row-Level Security (RLS) y encriptación de extremo a extremo.
        </p>
      </div>
      <div class="mt-6 flex gap-2">
        <div
          class="bg-espresso/10 text-espresso border-espresso/20 rounded-full border px-3 py-1 text-xs font-bold"
        >
          SOC2
        </div>
        <div
          class="bg-espresso/10 text-espresso border-espresso/20 rounded-full border px-3 py-1 text-xs font-bold"
        >
          GDPR
        </div>
      </div>
    </div>

    <!-- Card 3: Verifactu (Standard) -->
    <div
      class="border-border/50 bg-card/30 hover:bg-card group relative overflow-hidden rounded-3xl border p-8 transition-all duration-300 hover:shadow-xl md:col-span-1"
    >
      <div
        class="from-blueberry/5 absolute inset-0 bg-linear-to-tr to-transparent opacity-0 transition-opacity group-hover:opacity-100"
      >
      </div>
      <div class="relative z-10">
        <div
          class="bg-blueberry/10 text-blueberry mb-6 flex h-12 w-12 items-center justify-center rounded-2xl shadow-sm"
        >
          <FileCheck class="h-6 w-6" />
        </div>
        <h3 class="mb-3 font-serif text-xl font-medium">Verifactu Ready</h3>
        <p class="text-muted-foreground text-sm">
          Cumplimiento total con la Ley Antifraude. Facturación certificada y sellado inmutable.
        </p>
      </div>
    </div>

    <!-- Card 4: Speed/Optimistic UI (Large) -->
    <div
      class="group border-border/50 bg-card/30 hover:bg-card relative flex flex-col items-center gap-8 overflow-hidden rounded-3xl border p-8 transition-all duration-300 hover:shadow-xl md:col-span-2 md:flex-row"
    >
      <div
        class="from-tomato/5 absolute inset-0 bg-linear-to-l to-transparent opacity-0 transition-opacity group-hover:opacity-100"
      >
      </div>

      <div class="relative z-10 flex-1">
        <div
          class="bg-tomato/10 text-tomato mb-6 flex h-12 w-12 items-center justify-center rounded-2xl shadow-sm"
        >
          <Zap class="h-6 w-6" />
        </div>
        <h3 class="mb-3 font-serif text-2xl font-medium">Optimistic UI & Latencia Cero</h3>
        <p class="text-muted-foreground leading-relaxed">
          La interfaz responde instantáneamente al toque, sin esperar al servidor. Una experiencia
          nativa a 60fps que se siente "mágica".
        </p>
      </div>

      <!-- Speed Visual -->
      <div
        class="bg-background/50 border-border/50 relative flex h-32 w-full flex-1 items-center justify-center overflow-hidden rounded-xl border"
      >
        <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-20"></div>
        <div class="text-tomato animate-pulse font-mono text-sm font-bold tracking-widest">
          &lt; 10ms RESPONSE
        </div>
      </div>
    </div>
  </div>
</Section>
