---
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '../styles/globals.css';
import Navbar from '../components/navigation/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Tally. El sistema operativo para tu restaurante',
  description = 'Software completo para restaurantes: TPV, comandas digitales, split de cuenta por QR, y gestión integral. Offline-first, conforme con Verifactu. Cobra más rápido, rota más mesas, gana más.',
  ogImage = '/og-image.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// JSON-LD Structured Data
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tally',
  alternateName: 'Tally. El sistema operativo para tu restaurante',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, iOS, Android',
  description:
    'Software completo para restaurantes con TPV, comandas digitales, split de cuenta por QR, y gestión integral. Offline-first, conforme con Verifactu.',
  url: 'https://paytally.app',
  image: 'https://paytally.app/og-image.jpg',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '0',
    highPrice: '199',
    priceSpecification: [
      {
        '@type': 'UnitPriceSpecification',
        price: '0',
        priceCurrency: 'EUR',
        name: 'Essential',
      },
      {
        '@type': 'UnitPriceSpecification',
        price: '49',
        priceCurrency: 'EUR',
        name: 'Pro',
      },
      {
        '@type': 'UnitPriceSpecification',
        price: '199',
        priceCurrency: 'EUR',
        name: 'Enterprise',
      },
    ],
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: '120',
    bestRating: '5',
    worstRating: '1',
  },
  creator: {
    '@type': 'Organization',
    name: 'PayTally S.L.',
    url: 'https://paytally.app',
    logo: 'https://paytally.app/app-icon.svg',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Customer Service',
      availableLanguage: ['Spanish'],
    },
  },
  keywords:
    'tpv restaurante, software restaurante, pos hostelería, dividir cuenta, split cuenta, código qr restaurante, comandas digitales, verifactu',
  inLanguage: 'es',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="tpv restaurante, software restaurante, pos hostelería, dividir cuenta, split cuenta, código qr restaurante, pago móvil, comandas digitales, verifactu, gestión restaurante, facturación restaurante, sistema restaurante"
    />
    <meta name="author" content="PayTally S.L." />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Spanish" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tally - Sistema operativo para restaurantes" />
    <meta property="og:site_name" content="Tally" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta property="twitter:image:alt" content="Tally - Sistema operativo para restaurantes" />
    <meta property="twitter:creator" content="@paytally" />
    <meta property="twitter:site" content="@paytally" />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Animation Scripts -->
    <script>
      import '../scripts/animations';
      import '../scripts/scroll-animations';
      import '../scripts/micro-animations';
    </script>
  </head>
  <body
    class="bg-background text-foreground selection:bg-tomato/20 selection:text-foreground antialiased"
  >
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:px-4 focus:py-2"
    >
      Saltar al contenido principal
    </a>

    <!-- Global Background Effect - NO BLUR for WebKit performance -->
    <div class="pointer-events-none fixed inset-0 z-[-1]">
      <div
        class="absolute inset-0 hidden bg-[url('/noise.svg')] opacity-[0.015] mix-blend-overlay md:block"
      >
      </div>
      <div
        class="bg-primary/10 absolute top-0 right-0 left-0 -z-10 m-auto h-77.5 w-77.5 rounded-full opacity-30"
      >
      </div>
    </div>

    <Navbar />

    <main id="main-content" class="bg-background relative z-20">
      <div class="relative z-10">
        <slot />
      </div>
    </main>

    <!-- Fixed Footer: Revealed from bottom as content scrolls away -->
    <footer class="bg-background fixed right-0 bottom-0 left-0 z-10 py-12" style="height: 400px;">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto w-[90%]">
          <div class="mb-12 grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
            <div class="col-span-2 lg:col-span-2">
              <a href="/" class="mb-4 block font-serif text-2xl font-bold">Tally.</a>
              <p class="text-muted-foreground mb-6 max-w-xs text-sm leading-relaxed">
                El sistema operativo integral para la hostelería moderna.
              </p>
            </div>

            <div>
              <h4 class="mb-4 font-medium">Producto</h4>
              <ul class="text-muted-foreground space-y-3 text-sm">
                <li>
                  <a href="#features" class="hover:text-foreground transition-colors"
                    >Características</a
                  >
                </li>
                <li>
                  <a href="#pricing" class="hover:text-foreground transition-colors">Precios</a>
                </li>
                <li><a href="#demo" class="hover:text-foreground transition-colors">Demo</a></li>
              </ul>
            </div>

            <div>
              <h4 class="mb-4 font-medium">Recursos</h4>
              <ul class="text-muted-foreground space-y-3 text-sm">
                <li>
                  <a
                    href="https://docs.paytally.app"
                    class="hover:text-foreground transition-colors">Documentación</a
                  >
                </li>
                <li><a href="/blog" class="hover:text-foreground transition-colors">Blog</a></li>
              </ul>
            </div>

            <div>
              <h4 class="mb-4 font-medium">Legal</h4>
              <ul class="text-muted-foreground space-y-3 text-sm">
                <li>
                  <a href="/privacy" class="hover:text-foreground transition-colors">Privacidad</a>
                </li>
                <li>
                  <a href="/terms" class="hover:text-foreground transition-colors">Términos</a>
                </li>
              </ul>
            </div>
          </div>

          <div
            class="border-border text-muted-foreground flex flex-col items-center justify-between gap-4 border-t pt-6 text-sm md:flex-row"
          >
            <div>&copy; {new Date().getFullYear()} PayTally S.L.</div>
            <div>Álvaro Lostal.</div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
