---
import { ViewTransitions } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '../styles/globals.css';
import Navbar from '../components/navigation/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Tally - El Sistema Operativo para tu Restaurante',
  description = 'Software completo para restaurantes: TPV, comandas digitales, split de cuenta por QR, y gestión integral. Offline-first, conforme con Verifactu. Prueba gratuita.',
  ogImage = '/og-image.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// JSON-LD Structured Data
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tally',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, iOS, Android',
  description:
    'Software completo para restaurantes con TPV, comandas digitales, split de cuenta por QR, y gestión integral.',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '0',
    highPrice: '199',
    priceSpecification: [
      {
        '@type': 'UnitPriceSpecification',
        price: '0',
        priceCurrency: 'EUR',
        name: 'Essential',
      },
      {
        '@type': 'UnitPriceSpecification',
        price: '49',
        priceCurrency: 'EUR',
        name: 'Pro',
      },
      {
        '@type': 'UnitPriceSpecification',
        price: '199',
        priceCurrency: 'EUR',
        name: 'Enterprise',
      },
    ],
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: '120',
  },
  creator: {
    '@type': 'Organization',
    name: 'Tally',
    url: 'https://paytally.app',
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Tally" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- View Transitions -->
    <ViewTransitions />

    <!-- GSAP Animations -->
    <script>
      import '../scripts/animations';
    </script>
  </head>
  <body class="bg-background text-foreground antialiased selection:bg-primary/10 selection:text-primary">
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:px-4 focus:py-2"
    >
      Saltar al contenido principal
    </a>

    <!-- Global Background Effect - Fixed layer, isolated from content for Safari compatibility -->
    <div class="fixed inset-0 z-[-1] pointer-events-none">
       <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-[0.02] mix-blend-overlay"></div>
       <!-- Grid with bottom fade using mask-image (Safari-safe) -->
       <div
         class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"
         style="-webkit-mask-image: linear-gradient(to bottom, black 0%, black 60%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, black 60%, transparent 100%);"
       ></div>
       <div class="absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-primary/20 opacity-20 blur-[100px]"></div>
    </div>

    <Navbar />

    <main id="main-content" class="relative z-20 bg-background">
      <slot />
    </main>

    <!-- Fixed Footer: Revealed from bottom as content scrolls away -->
    <footer
      class="fixed bottom-0 left-0 right-0 z-10 py-12 bg-background"
      style="height: 400px; padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 3rem);"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
       <div class="w-[90%] mx-auto">
           <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 mb-12">
               <div class="col-span-2 lg:col-span-2">
                   <a href="/" class="font-serif text-2xl font-bold mb-4 block">Tally.</a>
                   <p class="text-muted-foreground text-sm leading-relaxed max-w-xs mb-6">
                       El sistema operativo integral para la hostelería moderna.
                   </p>
               </div>

               <div>
                   <h4 class="font-medium mb-4">Producto</h4>
                   <ul class="space-y-3 text-sm text-muted-foreground">
                       <li><a href="#features" class="hover:text-foreground transition-colors">Características</a></li>
                       <li><a href="#pricing" class="hover:text-foreground transition-colors">Precios</a></li>
                       <li><a href="#demo" class="hover:text-foreground transition-colors">Demo</a></li>
                   </ul>
               </div>

               <div>
                   <h4 class="font-medium mb-4">Recursos</h4>
                   <ul class="space-y-3 text-sm text-muted-foreground">
                       <li><a href="https://docs.paytally.app" class="hover:text-foreground transition-colors">Documentación</a></li>
                       <li><a href="/blog" class="hover:text-foreground transition-colors">Blog</a></li>
                   </ul>
               </div>

               <div>
                   <h4 class="font-medium mb-4">Legal</h4>
                   <ul class="space-y-3 text-sm text-muted-foreground">
                       <li><a href="/privacy" class="hover:text-foreground transition-colors">Privacidad</a></li>
                       <li><a href="/terms" class="hover:text-foreground transition-colors">Términos</a></li>
                   </ul>
               </div>
           </div>

           <div class="border-t border-border pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-muted-foreground">
               <div>&copy; {new Date().getFullYear()} PayTally S.L.</div>
               <div>Álvaro Lostal.</div>
           </div>
       </div>
      </div>
    </footer>
  </body>
</html>
